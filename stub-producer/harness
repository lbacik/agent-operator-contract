#!/usr/bin/env python3
"""Stub conformance harness: a test-only engine host executable.

Implements the Conformance Harness protocol (spec section 15.1) by steering a
stub producer container over the Docker CLI. Every verb is implemented: the
harness mutates the stub state file (``/data/agent-operator-contract.json``)
inside the container through ``docker exec`` python snippets, so the stub
engine honors holds, crashes, Halts and deferred publication across restarts.
Language-neutral: standard library only, no import of this repository's code.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import uuid
from typing import Any

HARNESS_VERSION = "1.0"

KNOWN_VERBS = (
    "setup",
    "teardown",
    "set-issue",
    "hold",
    "release",
    "finish-attempt",
    "hold-lock",
    "crash",
    "terminate",
    "stop-container",
    "start-container",
    "halt",
    "grow-archive",
    "defer-publication",
)

KNOWN_CAPABILITIES = (
    "stop-after",
    "next-issue",
    "operator-handoff",
    "recovery-retry",
    "recovery-release",
    "errors-reset",
    "pool",
)

NATIVE_OUTCOMES = (
    "complete",
    "incomplete",
    "infrastructure_error",
    "no_changes",
    "handoff",
)

HOLD_POINTS = ("before-claim", "after-claim", "native-phase", "after-outcome")

CRASH_POINTS = (
    "between-commit-and-reply",
    "before-claim",
    "after-claim",
    "during-finalization",
    "now",
)

STATE_FILE = "/data/agent-operator-contract.json"

CONFIG_FILE = "/data/agent-operator-contract.config.json"
"""Instance configuration on the volume (must match the stub CONFIG_FILENAME)."""

LOCK_FILE = "/data/agent-operator-contract.lock"
"""Engine lock file inside the container (must match the stub LOCK_FILENAME)."""

REPOSITORY_PATTERN = re.compile(r"^[^/\s]+/[^/\s]+$")

DOCKER_TIMEOUT = 120.0


def _docker() -> str:
    return os.environ.get("DOCKER", "docker")


def _image() -> str:
    return os.environ.get("STUB_PRODUCER_IMAGE", "stub-producer:dev")


def _state_path() -> str:
    return os.environ.get("STUB_HARNESS_STATE", "/tmp/stub-producer-harness-state.json")


def _render(doc: dict[str, Any]) -> str:
    return json.dumps(doc, sort_keys=True, separators=(",", ":")) + "\n"


def _ok(verb: str, result: dict[str, Any]) -> tuple[str, int]:
    return _render({"harness": HARNESS_VERSION, "verb": verb, "ok": True, "result": result}), 0


def _error(
    verb: str | None,
    code: str,
    message: str,
    details: dict[str, Any] | None = None,
) -> tuple[str, int]:
    error: dict[str, Any] = {"code": code, "message": message}
    if details is not None:
        error["details"] = details
    doc: dict[str, Any] = {"harness": HARNESS_VERSION, "ok": False, "error": error}
    if verb is not None:
        doc["verb"] = verb
    exits = {"failed": 1, "usage": 2, "unsupported": 3}
    return _render(doc), exits[code]


def _run_docker(args: list[str], stdin_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [_docker(), *args],
        input=stdin_text,
        capture_output=True,
        text=True,
        timeout=DOCKER_TIMEOUT,
    )


def _read_state() -> dict[str, Any] | None:
    try:
        with open(_state_path(), encoding="utf-8") as handle:
            doc = json.load(handle)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def _write_state(state: dict[str, Any]) -> None:
    with open(_state_path(), "w", encoding="utf-8") as handle:
        json.dump(state, handle)


def _clear_state() -> None:
    try:
        os.remove(_state_path())
    except FileNotFoundError:
        pass
    except OSError:
        pass


def _require_instance(verb: str) -> tuple[dict[str, Any] | None, tuple[str, int] | None]:
    state = _read_state()
    if not state or not state.get("container"):
        return None, _error(verb, "failed", "no instance; call setup first")
    return state, None


_FRESH_DOC = (
    '{"active_attempt":null,"attempt_counter":0,"attempt_order":[],"attempts":{},'
    '"commands":{},"crash_armed":null,"defer_armed":false,"engine_alive":true,'
    '"error_guard":false,"hold":null,"intake":"open","issues":{},'
    '"last_finished":null,"last_halt":null,'
    '"next_sequence":1,"pending_stop":null,"priority":null,"recent_events":[],'
    '"recovery_pending":false,"startup_hold":false,"stop_plan":null}'
)


def _exec_mutation(
    container: str, body: str
) -> tuple[dict[str, Any] | None, str]:
    """Run a state mutation snippet inside the container; return its JSON reply."""
    script = (
        "import datetime,json,os\n"
        f"path={STATE_FILE!r}\n"
        "try:\n"
        "    doc=json.load(open(path))\n"
        "    assert isinstance(doc,dict)\n"
        "except Exception:\n"
        f"    doc=json.loads({_FRESH_DOC!r})\n"
        "def _now():\n"
        "    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)"
        ".isoformat().replace('+00:00','Z')\n"
        "def _save(d):\n"
        "    tmp=path+'.tmp'\n"
        "    json.dump(d,open(tmp,'w'),sort_keys=True)\n"
        "    os.replace(tmp,path)\n"
        + body
        + "\n"
    )
    try:
        completed = _run_docker(
            ["exec", "-i", "--user", "agent", container, "python3", "-"],
            stdin_text=script,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"docker is unavailable: {exc}"
    if completed.returncode != 0:
        return None, f"engine mutation failed: {completed.stderr.strip()}"
    try:
        return json.loads(completed.stdout), ""
    except ValueError:
        return None, f"engine mutation returned non-JSON: {completed.stdout!r}"


def _write_volume_config(container: str, config: str) -> str | None:
    """Store the instance configuration on the volume for Offline Reads.

    ``docker run`` for an Offline Read carries no environment, so the stub
    ``agentctl`` reads repository and capabilities from this file instead.
    Returns a problem description, or None on success.
    """
    script = (
        "import os\n"
        f"path={CONFIG_FILE!r}\n"
        "tmp=path+'.tmp'\n"
        f"open(tmp,'w').write({config!r})\n"
        "os.replace(tmp,path)\n"
    )
    try:
        completed = _run_docker(
            ["exec", "-i", "--user", "agent", container, "python3", "-"],
            stdin_text=script,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"docker is unavailable: {exc}"
    if completed.returncode != 0:
        return f"writing the instance configuration failed: {completed.stderr.strip()}"
    return None


def _archive_snapshot_snippet(aid_expr: str, target: str, indent: str = "") -> str:
    """Build the engine snippet computing archive manifest entries into ``target``.

    The snippet rewrites the attempt's ``events.jsonl`` from state (so the
    snapshot covers every recorded event), creates ``transcript.jsonl`` once
    when missing without touching its bytes, then records one entry per file
    with its current size and sha256. ``aid_expr`` is snippet code evaluating
    to the attempt ID; the entries land in the snippet variable ``target``.
    Every line carries the ``indent`` prefix so the snippet slots into a block.
    """
    snippet = (
        "import hashlib,os\n"
        f"_adir='/data/archives/'+''.join(c if c.isalnum() or c in '-_' else '_' for c in {aid_expr})\n"
        "try:\n"
        "    os.makedirs(_adir,exist_ok=True)\n"
        "except OSError:\n"
        "    pass\n"
        "_epath=_adir+'/events.jsonl'\n"
        "_lines=[]\n"
        "for _e in doc.get('recent_events',[]):\n"
        f"    if isinstance(_e,dict) and _e.get('attempt_id')=={aid_expr}:\n"
        "        _lines.append(json.dumps(_e,sort_keys=True))\n"
        "try:\n"
        "    open(_epath,'w').write(''.join(_l+'\\n' for _l in _lines))\n"
        "except OSError:\n"
        "    pass\n"
        "_tpath=_adir+'/transcript.jsonl'\n"
        "if not os.path.exists(_tpath):\n"
        "    try:\n"
        f"        open(_tpath,'wb').write((json.dumps({{'attempt_id':{aid_expr},'stream':'transcript'}},sort_keys=True)+'\\n').encode())\n"
        "    except OSError:\n"
        "        pass\n"
        f"{target}=[]\n"
        "for _pn,_kk in (('events.jsonl','events'),('transcript.jsonl','transcript')):\n"
        "    try:\n"
        "        _dd=open(_adir+'/'+_pn,'rb').read()\n"
        "    except OSError:\n"
        "        _dd=b''\n"
        f"    {target}.append({{'path':_pn,'kind':_kk,'media_type':'application/x-ndjson','size':len(_dd),'sha256':hashlib.sha256(_dd).hexdigest()}})\n"
    )
    if indent:
        snippet = "".join(
            indent + line if line.strip() else line
            for line in snippet.splitlines(keepends=True)
        )
    return snippet


def _do_setup(verb: str, params: dict[str, Any]) -> tuple[str, int]:
    for key in params:
        if key not in ("repository", "capabilities", "config"):
            return _error(verb, "usage", f"harness 'setup' has an unexpected parameter: {key!r}")
    repository = params.get("repository")
    if not isinstance(repository, str) or REPOSITORY_PATTERN.search(repository) is None:
        return _error(verb, "usage", "harness 'setup' repository must be written owner/name")
    capabilities = params.get("capabilities")
    if capabilities is None:
        capabilities = [cap for cap in KNOWN_CAPABILITIES if cap != "pool"]
    elif not isinstance(capabilities, list) or any(
        not isinstance(item, str) or not item for item in capabilities
    ):
        return _error(
            verb, "usage", "harness 'setup' capabilities must be an array of non-empty strings"
        )
    for name in capabilities:
        if name not in KNOWN_CAPABILITIES:
            return _error(
                verb,
                "unsupported",
                f"stub harness cannot advertise capability {name!r}",
                {"what": "capability", "name": name},
            )
    config = params.get("config")
    if config is not None:
        if not isinstance(config, dict):
            return _error(verb, "usage", "harness 'setup' config must be an object")
        for key in config:
            if not key.startswith("native."):
                return _error(
                    verb,
                    "usage",
                    f"harness 'setup' config allows only native.* keys, got {key!r}",
                )
    existing = _read_state()
    if existing and existing.get("container"):
        return _error(verb, "failed", "an instance already exists; teardown first")
    name = f"stub-{uuid.uuid4().hex[:12]}"
    volume = f"{name}-data"
    try:
        created = _run_docker(["volume", "create", volume])
        if created.returncode != 0:
            return _error(verb, "failed", f"docker volume create failed: {created.stderr.strip()}")
        run = _run_docker(
            [
                "run",
                "-d",
                "--name",
                name,
                "--volume",
                f"{volume}:/data",
                "--env",
                f"CONTRACT_REPOSITORY={repository}",
                "--env",
                f"CONTRACT_CAPABILITIES={','.join(sorted(capabilities))}",
                _image(),
                "sleep",
                "infinity",
            ]
        )
        if run.returncode != 0:
            _run_docker(["volume", "rm", volume])
            return _error(verb, "failed", f"docker run failed: {run.stderr.strip()}")
        inspected = _run_docker(["inspect", "--format", "{{.Id}}", _image()])
        if inspected.returncode != 0:
            return _error(verb, "failed", f"docker inspect failed: {inspected.stderr.strip()}")
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _error(verb, "failed", f"docker is unavailable: {exc}")
    _write_state({"container": name, "volume": volume, "data_path": "/data"})
    volume_config = json.dumps({"repository": repository, "capabilities": sorted(capabilities)})
    written = _write_volume_config(name, volume_config)
    if written is not None:
        return _error(verb, "failed", written)
    startup_hold = False
    if isinstance(config, dict) and config.get("native.startup_hold") is True:
        startup_hold = True
    if startup_hold:
        _exec_mutation(name, "doc['startup_hold']=True\n_save(doc)\nprint('{}')")
    return _ok(
        verb,
        {
            "container": name,
            "image": inspected.stdout.strip(),
            "volumes": [{"name": volume, "path": "/data"}],
            "exec_user": "agent",
            "repository": repository,
            "capabilities": sorted(capabilities),
        },
    )


def _do_teardown(verb: str, params: dict[str, Any]) -> tuple[str, int]:
    if params:
        return _error(verb, "usage", "harness 'teardown' takes no parameters")
    state = _read_state()
    if not state or not state.get("container"):
        return _ok(verb, {"removed": False})
    container = str(state["container"])
    volume = str(state.get("volume", ""))
    try:
        removed = _run_docker(["rm", "--force", container])
        if volume:
            _run_docker(["volume", "rm", volume])
        if removed.returncode != 0:
            return _error(verb, "failed", f"docker rm failed: {removed.stderr.strip()}")
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _error(verb, "failed", f"docker is unavailable: {exc}")
    _clear_state()
    return _ok(verb, {"removed": True})


def _do_set_issue(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    for key in params:
        if key not in ("issue", "eligible", "title"):
            return _error(verb, "usage", f"harness 'set-issue' has an unexpected parameter: {key!r}")
    issue = params.get("issue")
    eligible = params.get("eligible")
    title = params.get("title")
    if type(issue) is not int or issue < 1:
        return _error(verb, "usage", "harness 'set-issue' issue must be an integer >= 1")
    if type(eligible) is not bool:
        return _error(verb, "usage", "harness 'set-issue' eligible must be a boolean")
    if title is not None and (not isinstance(title, str) or not title):
        return _error(verb, "usage", "harness 'set-issue' title must be a non-empty string")
    container = str(instance["container"])
    payload = json.dumps({"issue": issue, "eligible": eligible, "title": title})
    body = (
        f"p=json.loads({payload!r})\n"
        "issues=doc.setdefault('issues',{})\n"
        "issues[str(p['issue'])]={'eligible':p['eligible'],'title':p.get('title')}\n"
        "_save(doc)\n"
        "print(json.dumps({'issue':p['issue'],'eligible':p['eligible']}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"issue": int(reply["issue"]), "eligible": bool(reply["eligible"])})


def _do_hold(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    for key in params:
        if key not in ("point", "phase", "scope"):
            return _error(verb, "usage", f"harness 'hold' has an unexpected parameter: {key!r}")
    point = params.get("point")
    if point not in HOLD_POINTS:
        return _error(verb, "usage", "harness 'hold' point must name a known hold point")
    phase = params.get("phase")
    if point == "native-phase":
        if not isinstance(phase, str) or not phase:
            return _error(verb, "usage", "harness 'hold' phase is required at native-phase")
    elif "phase" in params:
        return _error(verb, "usage", "harness 'hold' phase is allowed only at native-phase")
    scope = params.get("scope", None)
    if scope is not None and scope not in ("next", "active"):
        return _error(verb, "usage", "harness 'hold' scope must be 'next' or 'active'")
    container = str(instance["container"])
    payload = json.dumps({"point": point, "phase": phase, "scope": scope})
    body = (
        f"p=json.loads({payload!r})\n"
        "active=doc.get('active_attempt')\n"
        "scope=p.get('scope') or ('active' if isinstance(active,dict) else 'next')\n"
        "if scope=='active' and not isinstance(active,dict):\n"
        "    print(json.dumps({'error':'no-active'}))\n"
        "else:\n"
        "    hold={'point':p['point']}\n"
        "    if p.get('phase') is not None:\n"
        "        hold['phase']=p['phase']\n"
        "    hold['scope']=scope\n"
        "    doc['hold']=hold\n"
        "    _save(doc)\n"
        "    aid=active.get('attempt_id') if isinstance(active,dict) else None\n"
        "    print(json.dumps({'attempt_id':aid}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    if "error" in reply:
        return _error(verb, "failed", "no active attempt to hold")
    attempt_id = reply.get("attempt_id")
    if attempt_id is not None and not isinstance(attempt_id, str):
        return _error(verb, "failed", "engine returned an invalid attempt_id")
    return _ok(verb, {"point": point, "attempt_id": attempt_id})


def _do_release(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    if params:
        return _error(verb, "usage", "harness 'release' takes no parameters")
    container = str(instance["container"])
    body = (
        "had=doc.get('hold') is not None or doc.get('startup_hold') is True"
        " or doc.get('recovery_pending') is True\n"
        "was_after=isinstance(doc.get('hold'),dict) and doc['hold'].get('point')=='after-outcome'\n"
        "doc['hold']=None\n"
        "starting=doc.get('startup_hold') is True\n"
        "doc['startup_hold']=False\n"
        "active=doc.get('active_attempt')\n"
        "finished=False\n"
        "if starting:\n"
        "    pass\n"
        "elif was_after and isinstance(active,dict) and isinstance(active.get('outcome_native'),str):\n"
        "    now=_now()\n"
        "    aid=active.get('attempt_id')\n"
        "    native=active['outcome_native']\n"
        "    reason=active.get('outcome_reason')\n"
        "    doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'attempt_finished','attempt_id':aid,"
        "'text':('finished '+str(aid))[:300]})\n"
        "    doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'sealed','attempt_id':aid,"
        "'text':('sealed '+str(aid))[:300]})\n"
        "    doc['recent_events']=doc['recent_events'][-50:]\n"
        + _archive_snapshot_snippet("aid", "_entries", indent="    ")
        + "    summary={'attempt_id':aid,"
        "'issue':{'number':active.get('issue_number',1),'title':active.get('issue_title')},"
        "'started_at':active.get('started_at',now),'finished_at':now,"
        "'lifecycle_state':'finished',"
        "'outcome':{'native':native,'reason':reason,"
        "'label':str(native).replace('_',' ').title()},"
        "'delivery':None,'attention_required':False,'sealed':True,'sealed_at':now,"
        "'manifest':_entries}\n"
        "    attempts=doc.setdefault('attempts',{})\n"
        "    order=doc.setdefault('attempt_order',[])\n"
        "    attempts[aid]=summary\n"
        "    order.append(aid)\n"
        "    doc['last_finished']=summary\n"
        "    doc['active_attempt']=None\n"
        "    finished=True\n"
        "elif doc.get('recovery_pending') is True:\n"
        "    doc['recovery_pending']=False\n"
        "    had=True\n"
        "    if isinstance(active,dict):\n"
        "        now=_now()\n"
        "        if not isinstance(active.get('outcome_native'),str):\n"
        "            active['outcome_native']='infrastructure_error'\n"
        "            active['outcome_reason']='terminated'\n"
        "        native=active['outcome_native']\n"
        "        reason=active.get('outcome_reason')\n"
        "        summary={'attempt_id':active.get('attempt_id'),"
        "'issue':{'number':active.get('issue_number',1),'title':active.get('issue_title')},"
        "'started_at':active.get('started_at',now),'finished_at':now,"
        "'lifecycle_state':'finished',"
        "'outcome':{'native':native,'reason':reason,"
        "'label':str(native).replace('_',' ').title()},"
        "'delivery':None,'attention_required':False,'sealed':True,'sealed_at':now}\n"
        "        attempts=doc.setdefault('attempts',{})\n"
        "        order=doc.setdefault('attempt_order',[])\n"
        "        attempts[summary['attempt_id']]=summary\n"
        "        order.append(summary['attempt_id'])\n"
        "        doc['last_finished']=summary\n"
        "        doc['active_attempt']=None\n"
        "        doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'outcome_recorded','attempt_id':summary['attempt_id'],"
        "'outcome':native,'reason':reason,"
        "'text':('outcome '+str(native))[:300]})\n"
        "        doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'attempt_finished','attempt_id':summary['attempt_id'],"
        "'text':('finished '+str(summary['attempt_id']))[:300]})\n"
        "        doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'sealed','attempt_id':summary['attempt_id'],"
        "'text':('sealed '+str(summary['attempt_id']))[:300]})\n"
        "        doc['recent_events']=doc['recent_events'][-50:]\n"
        "        finished=True\n"
        "        if active.get('publication_pending') is True:\n"
        "            had=True\n"
        "_save(doc)\n"
        "print(json.dumps({'released':bool(had or finished)}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"released": bool(reply.get("released", False))})


def _do_finish_attempt(
    verb: str, params: dict[str, Any], instance: dict[str, Any]
) -> tuple[str, int]:
    for key in params:
        if key not in ("native_outcome", "reason"):
            return _error(
                verb, "usage", f"harness 'finish-attempt' has an unexpected parameter: {key!r}"
            )
    outcome = params.get("native_outcome")
    if not isinstance(outcome, str) or not outcome:
        return _error(verb, "usage", "harness 'finish-attempt' native_outcome must be non-empty")
    if outcome not in NATIVE_OUTCOMES:
        return _error(
            verb,
            "unsupported",
            f"stub engine has no notion of outcome {outcome!r}",
            {"what": "native-outcome", "name": outcome},
        )
    reason = params.get("reason", None)
    if reason is not None and not isinstance(reason, str):
        return _error(verb, "usage", "harness 'finish-attempt' reason must be a string or null")
    container = str(instance["container"])
    payload = json.dumps({"native_outcome": outcome, "reason": reason})
    body = (
        f"p=json.loads({payload!r})\n"
        "active=doc.get('active_attempt')\n"
        "if not isinstance(active,dict):\n"
        "    print(json.dumps({'error':'no-active'}))\n"
        "else:\n"
        "    now=_now()\n"
        "    hold=doc.get('hold') if isinstance(doc.get('hold'),dict) else None\n"
        "    active['outcome_native']=p['native_outcome']\n"
        "    active['outcome_reason']=p.get('reason')\n"
        "    active['last_activity_at']=now\n"
        "    if p['native_outcome']=='infrastructure_error':\n"
        "        doc['error_guard']=True\n"
        "    doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'outcome_recorded','attempt_id':active.get('attempt_id'),"
        "'outcome':p['native_outcome'],'reason':p.get('reason'),"
        "'text':('outcome '+str(p['native_outcome']))[:300]})\n"
        "    doc['recent_events']=doc['recent_events'][-50:]\n"
        "    aid=active.get('attempt_id')\n"
        "    if isinstance(hold,dict) and hold.get('point')=='after-outcome':\n"
        + _archive_snapshot_snippet("aid", "_entries", indent="        ")
        + "        active['manifest_snapshot']=_entries\n"
        "        _save(doc)\n"
        "        print(json.dumps({'attempt_id':aid,'native_outcome':p['native_outcome'],"
        "'held':True}))\n"
        "    elif doc.get('defer_armed') is True:\n"
        "        doc['defer_armed']=False\n"
        "        active['publication_pending']=True\n"
        "        _save(doc)\n"
        "        print(json.dumps({'attempt_id':aid,'native_outcome':p['native_outcome'],"
        "'pending':True}))\n"
        "    elif isinstance(doc.get('crash_armed'),dict)"
        " and doc['crash_armed'].get('point')=='during-finalization':\n"
        "        doc['crash_armed']=None\n"
        "        doc['engine_alive']=False\n"
        "        doc['recovery_pending']=True\n"
        "        _save(doc)\n"
        "        print(json.dumps({'attempt_id':aid,'native_outcome':p['native_outcome'],"
        "'crashed':True}))\n"
        "    else:\n"
        "        summary={'attempt_id':aid,"
        "'issue':{'number':active.get('issue_number',1),'title':active.get('issue_title')},"
        "'started_at':active.get('started_at',now),'finished_at':now,"
        "'lifecycle_state':'finished',"
        "'outcome':{'native':p['native_outcome'],'reason':p.get('reason'),"
        "'label':str(p['native_outcome']).replace('_',' ').title()},"
        "'delivery':None,'attention_required':False,'sealed':True,'sealed_at':now}\n"
        "        attempts=doc.setdefault('attempts',{})\n"
        "        order=doc.setdefault('attempt_order',[])\n"
        "        attempts[aid]=summary\n"
        "        order.append(aid)\n"
        "        doc['last_finished']=summary\n"
        "        doc['active_attempt']=None\n"
        "        doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'attempt_finished','attempt_id':aid,'text':('finished '+str(aid))[:300]})\n"
        "        doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'sealed','attempt_id':aid,'text':('sealed '+str(aid))[:300]})\n"
        "        doc['recent_events']=doc['recent_events'][-50:]\n"
        "        _save(doc)\n"
        "        print(json.dumps({'attempt_id':aid,'native_outcome':p['native_outcome']}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    if "error" in reply:
        return _error(verb, "failed", "no active attempt to finish")
    return _ok(
        verb,
        {"attempt_id": str(reply["attempt_id"]), "native_outcome": str(reply["native_outcome"])},
    )


def _do_hold_lock(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    for key in params:
        if key not in ("duration_ms",):
            return _error(verb, "usage", f"harness 'hold-lock' has an unexpected parameter: {key!r}")
    duration = params.get("duration_ms")
    if type(duration) is not int or not 1 <= duration <= 60000:
        return _error(verb, "usage", "harness 'hold-lock' duration_ms must be 1..60000")
    container = str(instance["container"])
    data_path = str(instance.get("data_path", "/data"))
    lock_path = f"{data_path}/{LOCK_FILE.rsplit('/', 1)[-1]}"
    script = (
        "import fcntl,json,time\n"
        f"lock={lock_path!r}\n"
        f"duration={duration / 1000.0!r}\n"
        "handle=open(lock,'a')\n"
        "fcntl.flock(handle.fileno(),fcntl.LOCK_EX)\n"
        "started=time.monotonic()\n"
        "time.sleep(duration)\n"
        "held=max(1,round((time.monotonic()-started)*1000))\n"
        "fcntl.flock(handle.fileno(),fcntl.LOCK_UN)\n"
        "print(json.dumps({'held_ms':held}))\n"
    )
    try:
        completed = _run_docker(
            ["exec", "-i", "--user", "agent", container, "python3", "-"],
            stdin_text=script,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _error(verb, "failed", f"docker is unavailable: {exc}")
    if completed.returncode != 0:
        return _error(verb, "failed", f"engine lock hold failed: {completed.stderr.strip()}")
    try:
        reply = json.loads(completed.stdout)
    except ValueError:
        return _error(verb, "failed", f"engine lock hold returned non-JSON: {completed.stdout!r}")
    held_ms = reply.get("held_ms")
    if type(held_ms) is not int or held_ms < 1:
        return _error(verb, "failed", f"engine lock hold returned invalid held_ms: {held_ms!r}")
    return _ok(verb, {"held_ms": held_ms})


def _do_crash(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    for key in params:
        if key not in ("point",):
            return _error(verb, "usage", f"harness 'crash' has an unexpected parameter: {key!r}")
    point = params.get("point")
    if point not in CRASH_POINTS:
        return _error(verb, "usage", "harness 'crash' point must name a known crash point")
    container = str(instance["container"])
    if point == "now":
        body = (
            "now=_now()\n"
            "if isinstance(doc.get('active_attempt'),dict):\n"
            "    doc['recovery_pending']=True\n"
            "doc['engine_alive']=False\n"
            "_save(doc)\n"
            "print(json.dumps({'point':'now'}))\n"
        )
        reply, problem = _exec_mutation(container, body)
        if reply is None:
            return _error(verb, "failed", problem)
        return _ok(verb, {"point": "now"})
    payload = json.dumps({"point": point})
    body = (
        f"p=json.loads({payload!r})\n"
        "doc['crash_armed']={'point':p['point']}\n"
        "_save(doc)\n"
        "print(json.dumps({'point':p['point']}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"point": point})


def _do_terminate(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    if params:
        return _error(verb, "usage", "harness 'terminate' takes no parameters")
    container = str(instance["container"])
    body = (
        "now=_now()\n"
        "active=doc.get('active_attempt')\n"
        "if isinstance(active,dict):\n"
        "    active['interrupted']=True\n"
        "    active['last_activity_at']=now\n"
        "    doc['recovery_pending']=True\n"
        "doc['engine_alive']=False\n"
        "_save(doc)\n"
        "print(json.dumps({'signal':'SIGTERM'}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"signal": "SIGTERM"})


def _do_stop_container(
    verb: str, params: dict[str, Any], instance: dict[str, Any]
) -> tuple[str, int]:
    if params:
        return _error(verb, "usage", "harness 'stop-container' takes no parameters")
    container = str(instance["container"])
    try:
        stopped = _run_docker(["stop", container])
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _error(verb, "failed", f"docker is unavailable: {exc}")
    if stopped.returncode != 0:
        return _error(verb, "failed", f"docker stop failed: {stopped.stderr.strip()}")
    return _ok(verb, {"running": False})


def _do_start_container(
    verb: str, params: dict[str, Any], instance: dict[str, Any]
) -> tuple[str, int]:
    if params:
        return _error(verb, "usage", "harness 'start-container' takes no parameters")
    container = str(instance["container"])
    try:
        started = _run_docker(["start", container])
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _error(verb, "failed", f"docker is unavailable: {exc}")
    if started.returncode != 0:
        return _error(verb, "failed", f"docker start failed: {started.stderr.strip()}")
    body = (
        "now=_now()\n"
        "doc['engine_alive']=True\n"
        "doc['process_started_at']=now\n"
        "doc['startup_hold']=True\n"
        "act=doc.get('active_attempt')\n"
        "if isinstance(act,dict) and (act.get('publication_pending') is True"
        " or act.get('interrupted') is True):\n"
        "    doc['recovery_pending']=True\n"
        "doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'process_started','agent_version':'0.0.0',"
        "'text':'process started'[:300]})\n"
        "doc.setdefault('recent_events',[]).append({'at':now,'level':'info',"
        "'event':'startup_check','check':'stub_startup','result':'started',"
        "'text':'startup check stub_startup started'[:300]})\n"
        "doc['recent_events']=doc['recent_events'][-50:]\n"
        "_save(doc)\n"
        "print(json.dumps({'running':True}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"running": True})


def _do_halt(verb: str, params: dict[str, Any], instance: dict[str, Any]) -> tuple[str, int]:
    for key in params:
        if key not in ("reason", "detail"):
            return _error(verb, "usage", f"harness 'halt' has an unexpected parameter: {key!r}")
    reason = params.get("reason")
    if not isinstance(reason, str) or not reason:
        return _error(verb, "usage", "harness 'halt' reason must be a non-empty string")
    detail = params.get("detail", "")
    if detail is not None and not isinstance(detail, str):
        return _error(verb, "usage", "harness 'halt' detail must be a string")
    container = str(instance["container"])
    payload = json.dumps({"reason": reason, "detail": detail or ""})
    body = (
        f"p=json.loads({payload!r})\n"
        "now=_now()\n"
        "doc['last_halt']={'reason':p['reason'],'detail':p.get('detail') or '','at':now}\n"
        "doc.setdefault('recent_events',[]).append({'at':now,'level':'error',"
        "'event':'halted','reason':p['reason'],'text':('halted '+str(p['reason']))[:300]})\n"
        "doc['recent_events']=doc['recent_events'][-50:]\n"
        "if isinstance(doc.get('active_attempt'),dict):\n"
        "    doc['recovery_pending']=True\n"
        "doc['engine_alive']=False\n"
        "_save(doc)\n"
        "print(json.dumps({'reason':p['reason']}))\n"
    )
    reply, problem = _exec_mutation(container, body)
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"reason": reason})


def _do_grow_archive(
    verb: str, params: dict[str, Any], instance: dict[str, Any]
) -> tuple[str, int]:
    for key in params:
        if key not in ("attempt_id", "append_bytes"):
            return _error(
                verb, "usage", f"harness 'grow-archive' has an unexpected parameter: {key!r}"
            )
    append_bytes = params.get("append_bytes")
    if type(append_bytes) is not int or append_bytes < 1:
        return _error(verb, "usage", "harness 'grow-archive' append_bytes must be >= 1")
    attempt_id = params.get("attempt_id", None)
    if attempt_id is not None and not isinstance(attempt_id, str):
        return _error(verb, "usage", "harness 'grow-archive' attempt_id must be a string or null")
    container = str(instance["container"])
    payload = json.dumps({"attempt_id": attempt_id, "append_bytes": append_bytes})
    script = (
        "import json\n"
        f"p=json.loads({payload!r})\n"
        "path='/data/agent-operator-contract.json'\n"
        "try:\n"
        "    doc=json.load(open(path))\n"
        "except Exception:\n"
        "    doc={}\n"
        "active=doc.get('active_attempt') if isinstance(doc,dict) else None\n"
        "aid=p.get('attempt_id') or (active.get('attempt_id')"
        " if isinstance(active,dict) else None)\n"
        "attempts=doc.get('attempts') if isinstance(doc,dict) else None\n"
        "sealed=isinstance(attempts,dict) and isinstance(aid,str) and aid in attempts\n"
        "growing=isinstance(active,dict) and isinstance(aid,str) and active.get('attempt_id')==aid\n"
        "if not isinstance(aid,str) or not aid or (not growing and sealed):\n"
        "    print(json.dumps({'error':'sealed' if sealed else 'no-active'}))\n"
        "elif not growing:\n"
        "    print(json.dumps({'error':'no-active'}))\n"
        "else:\n"
        "    import os\n"
        "    adir='/data/archives/'+''.join(c if c.isalnum() or c in '-_' else '_'"
        " for c in aid)\n"
        "    try:\n"
        "        os.makedirs(adir,exist_ok=True)\n"
        "    except OSError:\n"
        "        pass\n"
        "    target=adir+'/transcript.jsonl'\n"
        "    if not os.path.exists(target):\n"
        "        open(target,'wb').write((json.dumps({'attempt_id':aid,'stream':'transcript'})+'\\n').encode())\n"
        "    n=int(p['append_bytes'])\n"
        "    with open(target,'ab') as fh:\n"
        "        fh.write(b'0'*n)\n"
        "    print(json.dumps({'path':'transcript.jsonl','appended_bytes':n}))\n"
    )
    try:
        completed = _run_docker(
            ["exec", "-i", "--user", "agent", container, "python3", "-"],
            stdin_text=script,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _error(verb, "failed", f"docker is unavailable: {exc}")
    if completed.returncode != 0:
        return _error(verb, "failed", f"engine mutation failed: {completed.stderr.strip()}")
    try:
        reply = json.loads(completed.stdout)
    except ValueError:
        return _error(verb, "failed", f"engine mutation returned non-JSON: {completed.stdout!r}")
    if "error" in reply:
        if reply["error"] == "sealed":
            return _error(verb, "failed", "the archive is sealed and immutable")
        return _error(verb, "failed", "no active attempt and no attempt_id to grow")
    return _ok(verb, {"path": str(reply["path"]), "appended_bytes": int(reply["appended_bytes"])})


def _do_defer_publication(
    verb: str, params: dict[str, Any], instance: dict[str, Any]
) -> tuple[str, int]:
    if params:
        return _error(verb, "usage", "harness 'defer-publication' takes no parameters")
    container = str(instance["container"])
    reply, problem = _exec_mutation(
        container, "doc['defer_armed']=True\n_save(doc)\nprint(json.dumps({'armed':True}))\n"
    )
    if reply is None:
        return _error(verb, "failed", problem)
    return _ok(verb, {"armed": True})


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        text, exit_code = _error(None, "usage", "expected: <harness> <verb> '<request-json>'")
        sys.stdout.write(text)
        return exit_code
    verb, raw = argv
    try:
        request = json.loads(raw)
    except ValueError:
        text, exit_code = _error(None, "usage", "the request document is not valid JSON")
        sys.stdout.write(text)
        return exit_code
    if not isinstance(request, dict) or request.get("verb") != verb:
        text, exit_code = _error(
            None, "usage", "the argv verb and the document verb must agree"
        )
        sys.stdout.write(text)
        return exit_code
    params = request.get("params")
    if not isinstance(params, dict):
        text, exit_code = _error(verb, "usage", "harness request params must be an object")
        sys.stdout.write(text)
        return exit_code
    if verb not in KNOWN_VERBS:
        text, exit_code = _error(verb, "usage", f"unknown harness verb: {verb!r}")
        sys.stdout.write(text)
        return exit_code
    if verb == "setup":
        text, exit_code = _do_setup(verb, params)
    elif verb == "teardown":
        text, exit_code = _do_teardown(verb, params)
    else:
        instance, failure = _require_instance(verb)
        if failure is not None:
            text, exit_code = failure
        elif verb == "set-issue":
            assert instance is not None
            text, exit_code = _do_set_issue(verb, params, instance)
        elif verb == "hold":
            assert instance is not None
            text, exit_code = _do_hold(verb, params, instance)
        elif verb == "release":
            assert instance is not None
            text, exit_code = _do_release(verb, params, instance)
        elif verb == "finish-attempt":
            assert instance is not None
            text, exit_code = _do_finish_attempt(verb, params, instance)
        elif verb == "hold-lock":
            assert instance is not None
            text, exit_code = _do_hold_lock(verb, params, instance)
        elif verb == "crash":
            assert instance is not None
            text, exit_code = _do_crash(verb, params, instance)
        elif verb == "terminate":
            assert instance is not None
            text, exit_code = _do_terminate(verb, params, instance)
        elif verb == "stop-container":
            assert instance is not None
            text, exit_code = _do_stop_container(verb, params, instance)
        elif verb == "start-container":
            assert instance is not None
            text, exit_code = _do_start_container(verb, params, instance)
        elif verb == "halt":
            assert instance is not None
            text, exit_code = _do_halt(verb, params, instance)
        elif verb == "grow-archive":
            assert instance is not None
            text, exit_code = _do_grow_archive(verb, params, instance)
        elif verb == "defer-publication":
            assert instance is not None
            text, exit_code = _do_defer_publication(verb, params, instance)
        else:  # pragma: no cover - KNOWN_VERBS is exhaustive above.
            text, exit_code = _error(
                verb, "unsupported", f"stub harness does not implement {verb!r}",
                {"what": "verb", "name": verb},
            )
    sys.stdout.write(text)
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
