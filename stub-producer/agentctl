#!/usr/bin/env python3
"""Stub producer ``agentctl``: a minimal, test-only engine (never published).

Serves ``identity``, ``status``, ``command`` and ``attempts list`` / ``attempts
show`` / ``attempts export`` (a minimal tar stream) plus the core mutations
``stop`` and ``resume`` (a ``stop --after`` plan and a one-shot ``next issue``
priority) with durable Intake, Claims and Attempts on its state volume. Recovery
runs at start, Halts
are recorded durably, and the engine honors the harness holds (notably
``before-claim``) and one-shot crashes armed by the harness. Reads never wait
on the engine lock: while a mutation or a harness ``hold-lock`` holds it,
``status`` serves the last prepared snapshot. Snapshots are bounded to 256
KiB with oldest-first truncation. Grammar, capability and value failures come
from the shared part of the library; the stub then applies the rest of the
section 4.1 order itself: ``--expect-repo``, ``payload_mismatch`` or replay,
then state (``rejected``) and commit.
"""

from __future__ import annotations

import base64
import datetime
import hashlib
import io
import json
import os
import sys
import tarfile
from typing import Any

from agent_operator_contract import shared

_FCNTL: Any
try:
    import fcntl

    _FCNTL = fcntl
except ImportError:  # pragma: no cover - POSIX-only lock; without it reads stay lock-free
    _FCNTL = None

STATE_FILENAME = "agent-operator-contract.json"
"""State file name inside the state directory (durable Intake, command store)."""

LOCK_FILENAME = "agent-operator-contract.lock"
"""Engine lock file inside the state directory (spec section 3.3 and 9.1).

Mutations hold an exclusive ``flock`` while committing. Reads never wait on
it: ``status`` serves the last prepared snapshot while it is held. The
conformance harness ``hold-lock`` verb holds this same lock for a duration.
"""

PREPARED_FILENAME = "agent-operator-contract.prepared.json"
"""Last prepared ``status`` snapshot, refreshed on every uncontended read."""

SNAPSHOT_MAX_BYTES = 256 * 1024
"""Maximum Status Snapshot size in bytes of compact JSON (spec section 9.1)."""

MAX_RECENT_COMMANDS = 20
MAX_RECENT_EVENTS = 50

NATIVE_OUTCOMES = ("complete", "incomplete", "infrastructure_error", "no_changes", "handoff")
"""Native outcomes the stub engine understands (spec section 16 mapping)."""

NATIVE_PHASES = ("claimed", "setup", "model_running", "pushing", "publishing")
"""Native phases the stub Attempt passes through (displayed as-is)."""


def _utc_now() -> str:
    return (
        datetime.datetime.now(datetime.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def _advertised_capabilities() -> set[str]:
    raw = os.environ.get("CONTRACT_CAPABILITIES")
    if raw is None:
        return set(shared.OPERATOR_CAPABILITIES) - {"pool"}
    return {piece.strip() for piece in raw.split(",") if piece.strip()}


def _repository() -> str:
    return os.environ.get("CONTRACT_REPOSITORY", "example-owner/example-repo")


def _state_path() -> str | None:
    """Return the state file path, or None when there is no state directory.

    Without a directory (for example a direct unit-test invocation with no
    volume) the stub still answers every call, but each call starts from a
    fresh volume: Intake open, no commands.
    """
    directory = os.environ.get("CONTRACT_STATE_DIR", "/data")
    if not os.path.isdir(directory):
        return None
    return os.path.join(directory, STATE_FILENAME)


def _fresh_state() -> dict[str, Any]:
    return {
        "intake": "open",
        "pending_stop": None,
        "stop_plan": None,
        "priority": None,
        "next_sequence": 1,
        "commands": {},
        "recent_events": [],
        "issues": {},
        "hold": None,
        "active_attempt": None,
        "attempts": {},
        "attempt_order": [],
        "last_finished": None,
        "last_halt": None,
        "engine_alive": True,
        "startup_hold": False,
        "recovery_pending": False,
        "crash_armed": None,
        "defer_armed": False,
        "attempt_counter": 0,
        "process_started_at": _utc_now(),
    }


def _load_state() -> tuple[dict[str, Any], str | None]:
    path = _state_path()
    if path is None:
        return _fresh_state(), None
    try:
        with open(path, encoding="utf-8") as handle:
            doc = json.load(handle)
    except (FileNotFoundError, OSError, ValueError):
        return _fresh_state(), path
    if not isinstance(doc, dict):
        return _fresh_state(), path
    state = _fresh_state()
    if doc.get("intake") in ("open", "closed"):
        state["intake"] = doc["intake"]
    pending = doc.get("pending_stop")
    if isinstance(pending, dict) or pending is None:
        state["pending_stop"] = pending
    plan = doc.get("stop_plan")
    if isinstance(plan, dict) or plan is None:
        state["stop_plan"] = plan
    priority = doc.get("priority")
    if isinstance(priority, dict) or priority is None:
        state["priority"] = priority
    if type(doc.get("next_sequence")) is int and doc["next_sequence"] >= 1:
        state["next_sequence"] = doc["next_sequence"]
    if isinstance(doc.get("commands"), dict):
        state["commands"] = doc["commands"]
    if isinstance(doc.get("recent_events"), list):
        state["recent_events"] = doc["recent_events"][-MAX_RECENT_EVENTS:]
    if isinstance(doc.get("issues"), dict):
        state["issues"] = {
            key: value
            for key, value in doc["issues"].items()
            if isinstance(value, dict)
        }
    hold = doc.get("hold")
    if isinstance(hold, dict) or hold is None:
        state["hold"] = hold
    active = doc.get("active_attempt")
    if isinstance(active, dict) or active is None:
        state["active_attempt"] = active
    if isinstance(doc.get("attempts"), dict):
        state["attempts"] = {
            key: value for key, value in doc["attempts"].items() if isinstance(value, dict)
        }
    if isinstance(doc.get("attempt_order"), list):
        state["attempt_order"] = [
            item for item in doc["attempt_order"] if isinstance(item, str)
        ]
    finished = doc.get("last_finished")
    if isinstance(finished, dict) or finished is None:
        state["last_finished"] = finished
    halt = doc.get("last_halt")
    if isinstance(halt, dict) or halt is None:
        state["last_halt"] = halt
    if type(doc.get("engine_alive")) is bool:
        state["engine_alive"] = doc["engine_alive"]
    if type(doc.get("startup_hold")) is bool:
        state["startup_hold"] = doc["startup_hold"]
    if type(doc.get("recovery_pending")) is bool:
        state["recovery_pending"] = doc["recovery_pending"]
    armed = doc.get("crash_armed")
    if isinstance(armed, dict) or armed is None:
        state["crash_armed"] = armed
    if type(doc.get("defer_armed")) is bool:
        state["defer_armed"] = doc["defer_armed"]
    if type(doc.get("attempt_counter")) is int and doc["attempt_counter"] >= 0:
        state["attempt_counter"] = doc["attempt_counter"]
    if isinstance(doc.get("process_started_at"), str):
        state["process_started_at"] = doc["process_started_at"]
    return state, path


def _save_state(state: dict[str, Any], path: str | None) -> None:
    if path is None:
        return
    tmp_path = path + ".tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as handle:
            json.dump(state, handle, sort_keys=True)
        os.replace(tmp_path, path)
    except OSError:
        try:
            os.remove(tmp_path)
        except OSError:
            pass
    _write_archives(state)


def _archives_dir() -> str | None:
    """Return the archives directory on the state volume, or None without one."""
    directory = os.environ.get("CONTRACT_STATE_DIR", "/data")
    if not os.path.isdir(directory):
        return None
    return os.path.join(directory, "archives")


def _safe_attempt_dir(attempt_id: str) -> str:
    return "".join(c if c.isalnum() or c in "-_" else "_" for c in attempt_id)


def _archive_events_path(attempt_id: str) -> str | None:
    base = _archives_dir()
    if base is None:
        return None
    return os.path.join(base, _safe_attempt_dir(attempt_id), "events.jsonl")


def _archive_transcript_path(attempt_id: str) -> str | None:
    """Growable second archive file (spec section 15.1 ``grow-archive``)."""
    base = _archives_dir()
    if base is None:
        return None
    return os.path.join(base, _safe_attempt_dir(attempt_id), "transcript.jsonl")


def _events_for_attempt(state: dict[str, Any], attempt_id: str) -> list[dict[str, Any]]:
    events = state.get("recent_events")
    if not isinstance(events, list):
        return []
    return [
        event
        for event in events
        if isinstance(event, dict) and event.get("attempt_id") == attempt_id
    ]


def _write_archives(state: dict[str, Any]) -> None:
    """Persist per-attempt ``events.jsonl`` files on the state volume.

    Every Attempt Archive holds that Attempt's events in ``events.jsonl``,
    plus a growable ``transcript.jsonl`` that ``grow-archive`` appends to.
    The transcript file is created once and never rewritten, so a grow
    survives the next export; the events file is regenerated from state.
    Best-effort: failures never fail the operation itself.
    """
    base = _archives_dir()
    if base is None:
        return
    attempt_ids: set[str] = set()
    active = state.get("active_attempt")
    if isinstance(active, dict):
        attempt_id = active.get("attempt_id")
        if isinstance(attempt_id, str) and attempt_id:
            attempt_ids.add(attempt_id)
    attempts = state.get("attempts")
    if isinstance(attempts, dict):
        for key in attempts:
            if isinstance(key, str) and key:
                attempt_ids.add(key)
    for attempt_id in attempt_ids:
        path = _archive_events_path(attempt_id)
        if path is None:
            continue
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            lines = _events_for_attempt(state, attempt_id)
            with open(path, "w", encoding="utf-8") as handle:
                for event in lines:
                    handle.write(json.dumps(event, sort_keys=True) + "\n")
        except OSError:
            continue
        transcript = _archive_transcript_path(attempt_id)
        if transcript is None:
            continue
        try:
            if not os.path.exists(transcript):
                with open(transcript, "wb") as handle:
                    handle.write(
                        json.dumps(
                            {"attempt_id": attempt_id, "stream": "transcript"},
                            sort_keys=True,
                        ).encode()
                        + b"\n"
                    )
        except OSError:
            continue


def _encode_cursor(offset: int) -> str:
    raw = json.dumps({"offset": offset}, sort_keys=True).encode("utf-8")
    return base64.urlsafe_b64encode(raw).decode("ascii")


def _decode_cursor(cursor: str) -> int | None:
    try:
        padded = cursor + "=" * (-len(cursor) % 4)
        raw = base64.urlsafe_b64decode(padded.encode("ascii"))
        doc = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(doc, dict):
        return None
    offset = doc.get("offset")
    if type(offset) is not int or offset < 0:
        return None
    if set(doc) != {"offset"}:
        return None
    return offset


def _lock_path() -> str | None:
    """Return the engine lock file path, or None when locking is unavailable."""
    if _FCNTL is None:
        return None
    directory = os.environ.get("CONTRACT_STATE_DIR", "/data")
    if not os.path.isdir(directory):
        return None
    return os.path.join(directory, LOCK_FILENAME)


def _prepared_path() -> str | None:
    """Return the prepared snapshot path, or None without a state directory."""
    directory = os.environ.get("CONTRACT_STATE_DIR", "/data")
    if not os.path.isdir(directory):
        return None
    return os.path.join(directory, PREPARED_FILENAME)


def _acquire_nonblocking(lock_path: str | None) -> io.TextIO | None:
    """Take the engine lock without waiting; None when held or unavailable."""
    if _FCNTL is None or lock_path is None:
        return None
    handle = open(lock_path, "a", encoding="utf-8")
    try:
        _FCNTL.flock(handle.fileno(), _FCNTL.LOCK_EX | _FCNTL.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def _acquire_blocking(lock_path: str | None) -> io.TextIO | None:
    """Take the engine lock, waiting until it is free; None when unavailable."""
    if _FCNTL is None or lock_path is None:
        return None
    handle = open(lock_path, "a", encoding="utf-8")
    _FCNTL.flock(handle.fileno(), _FCNTL.LOCK_EX)
    return handle


def _release_lock(handle: io.TextIO | None) -> None:
    """Release a lock taken by ``_acquire_blocking`` or ``_acquire_nonblocking``."""
    if handle is None:
        return
    try:
        if _FCNTL is not None:
            _FCNTL.flock(handle.fileno(), _FCNTL.LOCK_UN)
    finally:
        handle.close()


def _live_holder_present() -> bool:
    """Probe whether a live engine holds the volume lock (spec section 12).

    An Offline Read mounts the volume read-only, so opening the lock file for
    writing fails and there is no live holder in this mount: serve the read.
    When another process holds the exclusive lock, a live engine owns the
    volume and the offline read must be refused. A free lock means no engine
    is running: serve the read.
    """
    lock_path = _lock_path()
    if _FCNTL is None or lock_path is None:
        return False
    try:
        handle = open(lock_path, "a", encoding="utf-8")
    except OSError:
        return False
    try:
        _FCNTL.flock(handle.fileno(), _FCNTL.LOCK_EX | _FCNTL.LOCK_NB)
    except OSError:
        handle.close()
        return True
    _release_lock(handle)
    return False


def _snapshot_size_bytes(snapshot: dict[str, Any]) -> int:
    """Measure a snapshot the way spec section 9.1 bounds it: compact JSON."""
    return len(json.dumps(snapshot, sort_keys=True, separators=(",", ":")).encode("utf-8"))


def _apply_bounds(snapshot: dict[str, Any]) -> dict[str, Any]:
    """Enforce the section 9.1 bounds: size, counts, oldest-first truncation.

    Over 256 KiB of compact JSON the producer drops the oldest
    ``recent_events`` first, then optional figures, then the oldest
    ``recent_commands``, and sets ``truncated: true``. Count caps hold always.
    The input is never mutated.
    """
    bounded = dict(snapshot)
    events = list(bounded.get("recent_events") or [])
    commands = list(bounded.get("recent_commands") or [])
    attempt = bounded.get("current_attempt")
    attempt_doc = dict(attempt) if isinstance(attempt, dict) else None
    figures: dict[str, Any] = {}
    had_figures = False
    if attempt_doc is not None:
        raw_figures = attempt_doc.get("figures")
        had_figures = isinstance(raw_figures, dict)
        figures = dict(raw_figures) if had_figures else {}
    bounded["recent_events"] = events
    bounded["recent_commands"] = commands
    if attempt_doc is not None:
        if figures or had_figures:
            attempt_doc["figures"] = figures
        bounded["current_attempt"] = attempt_doc
    if len(events) > MAX_RECENT_EVENTS:
        bounded["recent_events"] = events = events[-MAX_RECENT_EVENTS:]
    if len(commands) > MAX_RECENT_COMMANDS:
        bounded["recent_commands"] = commands = commands[-MAX_RECENT_COMMANDS:]
    truncated = False
    while _snapshot_size_bytes(bounded) > SNAPSHOT_MAX_BYTES and (
        events or figures or commands
    ):
        if events:
            del events[0]
        elif figures:
            figures.pop(next(iter(figures)))
        else:
            del commands[0]
        truncated = True
    bounded["truncated"] = bool(bounded.get("truncated")) or truncated
    return bounded


def _write_prepared(snapshot: dict[str, Any]) -> None:
    """Refresh the prepared snapshot cache; failures stay best-effort."""
    path = _prepared_path()
    if path is None:
        return
    try:
        tmp_path = path + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as handle:
            json.dump(snapshot, handle, sort_keys=True)
        os.replace(tmp_path, path)
    except OSError:
        try:
            os.remove(tmp_path)
        except OSError:
            pass


def _read_prepared() -> dict[str, Any] | None:
    """Return the last prepared snapshot, or None when there is none yet."""
    path = _prepared_path()
    if path is None:
        return None
    try:
        with open(path, encoding="utf-8") as handle:
            doc = json.load(handle)
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def _append_event(state: dict[str, Any], event: dict[str, Any]) -> None:
    events = state.setdefault("recent_events", [])
    assert isinstance(events, list)
    events.append(event)
    del events[: max(0, len(events) - MAX_RECENT_EVENTS)]


def _identity(offline: bool, state: dict[str, Any] | None = None) -> dict[str, object]:
    capabilities = sorted(_advertised_capabilities())
    if offline:
        started_at: str | None = None
    elif state is not None and isinstance(state.get("process_started_at"), str):
        started_at = str(state["process_started_at"])
    else:
        started_at = os.environ.get("CONTRACT_STARTED_AT", _utc_now())
    return {
        "backend": os.environ.get("CONTRACT_BACKEND", "stub"),
        "agent_version": os.environ.get("CONTRACT_AGENT_VERSION", "0.0.0"),
        "contract": {"major": 1, "minor": 0},
        "repository": _repository(),
        "mode": "offline" if offline else "online",
        "process_started_at": started_at,
        "capabilities": capabilities,
    }


def _recent_commands(state: dict[str, Any]) -> list[dict[str, Any]]:
    commands = state.get("commands")
    if not isinstance(commands, dict):
        return []
    records = [
        entry["record"]
        for entry in commands.values()
        if isinstance(entry, dict) and isinstance(entry.get("record"), dict)
    ]
    records.sort(key=lambda record: record.get("sequence", 0))
    return records[-MAX_RECENT_COMMANDS:]


def _stub_budget() -> dict[str, Any]:
    unknown = {"value": None, "unit": "tokens", "basis": "unavailable",
               "reason": "stub has no telemetry"}
    return {
        "raw_tokens": dict(unknown),
        "effective_tokens": dict(unknown),
        "enforced_tokens": "none",
        "limits": [],
    }


def _current_attempt_doc(state: dict[str, Any], now: str) -> dict[str, Any] | None:
    active = state.get("active_attempt")
    if not isinstance(active, dict):
        return None
    return {
        "attempt_id": active.get("attempt_id", ""),
        "issue": {
            "number": active.get("issue_number", 1),
            "title": active.get("issue_title"),
        },
        "native_phase": active.get("native_phase", "claimed"),
        "started_at": active.get("started_at", now),
        "last_activity_at": active.get("last_activity_at"),
        "observed_at": now,
        "budget": _stub_budget(),
        "figures": {},
    }


def _instance_state(state: dict[str, Any], offline: bool) -> tuple[str, str | None]:
    if offline:
        return "stopped", None
    if state.get("startup_hold") is True:
        return "starting", "stub_startup"
    if state.get("recovery_pending") is True:
        return "recovering", None
    if isinstance(state.get("active_attempt"), dict):
        if state.get("intake") == "open":
            return "active", None
        return "draining", None
    if state.get("intake") == "open":
        return "idle", None
    return "paused", None


def _status(offline: bool, state: dict[str, Any]) -> dict[str, object]:
    now = _utc_now()
    identity = _identity(offline, state)
    instance_state, startup_check = _instance_state(state, offline)
    instance: dict[str, object] = {
        "last_halt": state.get("last_halt"),
        "observed_at": now,
        "startup_check": startup_check,
        "state": instance_state,
    }
    return {
        "current_attempt": None if offline else _current_attempt_doc(state, now),
        "generated_at": now,
        "identity": identity,
        "instance": instance,
        "intake": {
            "observed_at": now,
            "pending_stop": state.get("pending_stop"),
            "priority": _priority_status(state),
            "state": state.get("intake", "open"),
            "stop_plan": state.get("stop_plan"),
        },
        "last_finished": state.get("last_finished"),
        "recent_commands": _recent_commands(state),
        "recent_events": state.get("recent_events", []),
        "truncated": False,
    }


def _priority_status(state: dict[str, Any]) -> dict[str, Any] | None:
    """Render the durable one-shot issue priority for the status snapshot."""
    priority = state.get("priority")
    if not isinstance(priority, dict):
        return None
    request_id = priority.get("request_id")
    issue = priority.get("issue")
    if not isinstance(request_id, str) or type(issue) is not int or issue < 1:
        return None
    return {"request_id": request_id, "issue": issue}


def _resolve_priority(
    state: dict[str, Any], acknowledgement: str, detail: str
) -> None:
    """Move the pending priority to a final acknowledgement and clear it."""
    priority = state.get("priority")
    if not isinstance(priority, dict):
        return
    now = _utc_now()
    commands = state.get("commands")
    request_id = priority.get("request_id")
    if isinstance(commands, dict) and isinstance(request_id, str):
        entry = commands.get(request_id)
        if (
            isinstance(entry, dict)
            and isinstance(entry.get("record"), dict)
            and entry["record"].get("acknowledgement") == "accepted"
        ):
            entry["record"]["acknowledgement"] = acknowledgement
            entry["record"]["updated_at"] = now
            entry["record"]["detail"] = detail
    state["priority"] = None
    _append_event(
        state,
        {
            "at": now,
            "level": "info",
            "event": "command_resolved",
            "request_id": request_id,
            "acknowledgement": acknowledgement,
            "text": f"command {request_id} {acknowledgement}",
        },
    )


def _eligible_issue(state: dict[str, Any]) -> tuple[int, str | None] | None:
    issues = state.get("issues")
    if not isinstance(issues, dict):
        return None
    for key in sorted(issues, key=lambda k: int(k) if k.isdigit() else 0):
        try:
            number = int(key)
        except ValueError:
            continue
        entry = issues[key]
        if isinstance(entry, dict) and entry.get("eligible") is True and number >= 1:
            title = entry.get("title")
            return number, title if isinstance(title, str) else None
    return None


def _held_before_claim(state: dict[str, Any]) -> bool:
    hold = state.get("hold")
    return isinstance(hold, dict) and hold.get("point") == "before-claim"


def _maybe_complete_pending_stop(state: dict[str, Any]) -> None:
    pending = state.get("pending_stop")
    if not isinstance(pending, dict):
        return
    if isinstance(state.get("active_attempt"), dict):
        return
    now = _utc_now()
    commands = state.get("commands")
    request_id = pending.get("request_id")
    if isinstance(commands, dict) and isinstance(request_id, str):
        entry = commands.get(request_id)
        if (
            isinstance(entry, dict)
            and isinstance(entry.get("record"), dict)
            and entry["record"].get("acknowledgement") == "accepted"
        ):
            entry["record"]["acknowledgement"] = "completed"
            entry["record"]["updated_at"] = now
            entry["record"]["detail"] = "active attempt finished; intake drained"
    state["pending_stop"] = None
    _append_event(
        state,
        {
            "at": now,
            "level": "info",
            "event": "command_resolved",
            "request_id": request_id,
            "acknowledgement": "completed",
            "text": f"command {request_id} completed",
        },
    )


def _maybe_count_stop_plan(state: dict[str, Any]) -> None:
    plan = state.get("stop_plan")
    if not isinstance(plan, dict):
        return
    if isinstance(state.get("active_attempt"), dict):
        return
    last = state.get("last_finished")
    if not isinstance(last, dict):
        return
    last_id = last.get("attempt_id")
    if not isinstance(last_id, str) or plan.get("last_counted") == last_id:
        return
    remaining = plan.get("remaining", 0)
    counted = plan.get("counted", 0)
    if not isinstance(remaining, int) or not isinstance(counted, int):
        return
    now = _utc_now()
    plan["counted"] = counted + 1
    plan["last_counted"] = last_id
    if plan["counted"] >= remaining:
        commands = state.get("commands")
        request_id = plan.get("request_id")
        if isinstance(commands, dict) and isinstance(request_id, str):
            entry = commands.get(request_id)
            if (
                isinstance(entry, dict)
                and isinstance(entry.get("record"), dict)
                and entry["record"].get("acknowledgement") == "accepted"
            ):
                entry["record"]["acknowledgement"] = "completed"
                entry["record"]["updated_at"] = now
                entry["record"]["detail"] = "intake closed after planned attempts"
        state["intake"] = "closed"
        state["stop_plan"] = None
        _append_event(
            state,
            {
                "at": now,
                "level": "info",
                "event": "command_resolved",
                "request_id": request_id,
                "acknowledgement": "completed",
                "text": f"command {request_id} completed",
            },
        )


def _maybe_open_claim(state: dict[str, Any]) -> str | None:
    """Try to open a Claim; return ``"crashed"`` when a one-shot crash fires."""
    if state.get("engine_alive") is not True:
        return None
    if state.get("startup_hold") is True:
        return None
    if state.get("recovery_pending") is True:
        return None
    if isinstance(state.get("active_attempt"), dict):
        return None
    if state.get("intake") != "open":
        return None
    armed = state.get("crash_armed")
    if isinstance(armed, dict) and armed.get("point") == "before-claim":
        state["crash_armed"] = None
        state["engine_alive"] = False
        return "crashed"
    if _held_before_claim(state):
        return None
    priority = state.get("priority")
    if isinstance(priority, dict) and type(priority.get("issue")) is int:
        number = int(priority["issue"])
        issues = state.get("issues")
        entry = (
            issues.get(str(number)) if isinstance(issues, dict) else None
        )
        if isinstance(entry, dict) and entry.get("eligible") is False:
            _resolve_priority(
                state,
                "not_fulfilled",
                f"issue {number} is not eligible at the claim boundary",
            )
        else:
            title = None
            if isinstance(entry, dict):
                raw_title = entry.get("title")
                title = raw_title if isinstance(raw_title, str) else None
            _resolve_priority(
                state, "completed", f"prioritized issue {number} claimed"
            )
            return _open_claim(state, number, title, armed)
    found = _eligible_issue(state)
    if found is None:
        return None
    number, title = found
    return _open_claim(state, number, title, armed)


def _open_claim(
    state: dict[str, Any],
    number: int,
    title: str | None,
    armed: Any,
) -> str | None:
    """Open a Claim for one issue number; ``"crashed"`` on a one-shot crash."""
    if isinstance(armed, dict) and armed.get("point") == "after-claim":
        state["crash_armed"] = None
        state["engine_alive"] = False
        state["recovery_pending"] = True
    now = _utc_now()
    state["attempt_counter"] = int(state.get("attempt_counter", 0)) + 1
    attempt_id = f"stub-{state['attempt_counter']}"
    state["active_attempt"] = {
        "attempt_id": attempt_id,
        "issue_number": number,
        "issue_title": title,
        "native_phase": "claimed",
        "started_at": now,
        "last_activity_at": now,
    }
    _append_event(
        state,
        {
            "at": now,
            "level": "info",
            "event": "claim_opened",
            "attempt_id": attempt_id,
            "issue": number,
            "text": f"claimed issue #{number}",
        },
    )
    if isinstance(armed, dict) and armed.get("point") == "after-claim":
        return "crashed"
    # Snapshot the archive manifest when the claim opens: an export serves
    # the snapshot while streaming the live bytes, so a file that grows
    # while the archive is unsealed no longer matches its manifest entry
    # (the torn read of spec section 14). The snapshot is refreshed when
    # the outcome is recorded and replaced by the sealed manifest.
    active = state.get("active_attempt")
    assert isinstance(active, dict)
    active["manifest_snapshot"] = _fresh_manifest(state, {"attempt_id": attempt_id})
    return "opened"


def _tick(state: dict[str, Any]) -> str | None:
    """Advance the engine one step; return ``"crashed"`` when a crash fires."""
    _maybe_complete_pending_stop(state)
    _maybe_count_stop_plan(state)
    return _maybe_open_claim(state)


def _mutation_payload(operation: str, arguments: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    """Return the canonical (kind, arguments) payload an operation commits."""
    if operation == "stop" and "after" in arguments:
        return "stop_after", {"after": int(arguments["after"], 10)}
    if operation == "next-issue":
        return "next_issue", {"issue": int(arguments["issue"], 10)}
    return operation, {}


def _commit(
    state: dict[str, Any],
    request_id: str,
    kind: str,
    arguments: dict[str, Any],
    acknowledgement: str,
    detail: str,
) -> dict[str, Any]:
    sequence = state.get("next_sequence", 1)
    now = _utc_now()
    record = {
        "request_id": request_id,
        "sequence": sequence,
        "kind": kind,
        "arguments": arguments,
        "repository": _repository(),
        "acknowledgement": acknowledgement,
        "detail": detail,
        "created_at": now,
        "updated_at": now,
    }
    commands = state.setdefault("commands", {})
    assert isinstance(commands, dict)
    commands[request_id] = {"kind": kind, "arguments": arguments, "record": record}
    state["next_sequence"] = sequence + 1
    _append_event(
        state,
        {
            "at": now,
            "level": "info",
            "event": "command_accepted",
            "request_id": request_id,
            "kind": kind,
            "acknowledgement": acknowledgement,
            "text": f"command {request_id} {acknowledgement}",
        },
    )
    if acknowledgement != "accepted":
        _append_event(
            state,
            {
                "at": now,
                "level": "info",
                "event": "command_resolved",
                "request_id": request_id,
                "acknowledgement": acknowledgement,
                "text": f"command {request_id} {acknowledgement}",
            },
        )
    return record


def _supersede(state: dict[str, Any], ref: dict[str, Any] | None) -> None:
    """Mark the pending command or plan ``ref`` superseded (spec section 8.2)."""
    if not isinstance(ref, dict):
        return
    now = _utc_now()
    commands = state.get("commands")
    request_id = ref.get("request_id")
    if isinstance(commands, dict) and isinstance(request_id, str):
        entry = commands.get(request_id)
        if (
            isinstance(entry, dict)
            and isinstance(entry.get("record"), dict)
            and entry["record"].get("acknowledgement") == "accepted"
        ):
            entry["record"]["acknowledgement"] = "superseded"
            entry["record"]["updated_at"] = now
    _append_event(
        state,
        {
            "at": now,
            "level": "info",
            "event": "command_resolved",
            "request_id": request_id,
            "acknowledgement": "superseded",
            "text": f"command {request_id} superseded",
        },
    )


def _fire_between_commit_and_reply(
    state: dict[str, Any], path: str | None, request_id: str
) -> int:
    state["crash_armed"] = None
    state["engine_alive"] = False
    _save_state(state, path)
    text, exit_code = shared.render_error(
        "agent_unreachable",
        "the engine died between commit and reply; retry with the same request ID",
        request_id=request_id,
    )
    sys.stdout.write(text)
    return exit_code


def _do_stop(
    state: dict[str, Any], path: str | None, request_id: str, arguments: dict[str, Any]
) -> int:
    kind, payload = _mutation_payload("stop", arguments)
    if state.get("intake") == "closed" and state.get("pending_stop") is None:
        text, exit_code = shared.render_error(
            "rejected",
            "intake is already closed",
            request_id=request_id,
        )
        sys.stdout.write(text)
        return exit_code
    if kind == "stop_after":
        _supersede(state, state.get("pending_stop"))
        _supersede(state, state.get("stop_plan"))
        state["pending_stop"] = None
        remaining = payload["after"]
        record = _commit(
            state,
            request_id,
            kind,
            payload,
            "accepted",
            f"close intake after {remaining} more finalized attempts",
        )
        state["stop_plan"] = {
            "request_id": request_id,
            "sequence": record["sequence"],
            "remaining": remaining,
            "counted": 0,
        }
        _save_state(state, path)
    elif isinstance(state.get("active_attempt"), dict):
        _supersede(state, state.get("pending_stop"))
        _supersede(state, state.get("stop_plan"))
        state["stop_plan"] = None
        record = _commit(
            state,
            request_id,
            kind,
            payload,
            "accepted",
            "intake closing; finishes with the active attempt",
        )
        state["intake"] = "closed"
        state["pending_stop"] = {
            "request_id": request_id,
            "sequence": record["sequence"],
        }
        _save_state(state, path)
    else:
        _supersede(state, state.get("pending_stop"))
        _supersede(state, state.get("stop_plan"))
        state["pending_stop"] = None
        state["stop_plan"] = None
        state["intake"] = "closed"
        record = _commit(state, request_id, kind, payload, "completed", "intake closed by operator")
        _save_state(state, path)
    armed = state.get("crash_armed")
    if isinstance(armed, dict) and armed.get("point") == "between-commit-and-reply":
        return _fire_between_commit_and_reply(state, path, request_id)
    sys.stdout.write(shared.render_success({"command": record, "replayed": False}))
    return 0


def _do_resume(state: dict[str, Any], path: str | None, request_id: str) -> int:
    if (
        state.get("intake") == "open"
        and state.get("pending_stop") is None
        and state.get("stop_plan") is None
    ):
        text, exit_code = shared.render_error(
            "rejected",
            "intake is already open",
            request_id=request_id,
        )
        sys.stdout.write(text)
        return exit_code
    _supersede(state, state.get("pending_stop"))
    _supersede(state, state.get("stop_plan"))
    state["pending_stop"] = None
    state["stop_plan"] = None
    state["intake"] = "open"
    record = _commit(state, request_id, "resume", {}, "completed", "intake reopened by operator")
    _save_state(state, path)
    armed = state.get("crash_armed")
    if isinstance(armed, dict) and armed.get("point") == "between-commit-and-reply":
        return _fire_between_commit_and_reply(state, path, request_id)
    sys.stdout.write(shared.render_success({"command": record, "replayed": False}))
    return 0


def _do_next_issue(
    state: dict[str, Any], path: str | None, request_id: str, arguments: dict[str, Any]
) -> int:
    """Commit a one-shot issue priority for the next Claim (spec section 8.3)."""
    issue = int(arguments["issue"], 10)
    issues = state.get("issues")
    entry = issues.get(str(issue)) if isinstance(issues, dict) else None
    if isinstance(entry, dict) and entry.get("eligible") is False:
        text, exit_code = shared.render_error(
            "rejected",
            f"issue {issue} is not eligible for selection",
            request_id=request_id,
        )
        sys.stdout.write(text)
        return exit_code
    _supersede(state, state.get("priority"))
    record = _commit(
        state,
        request_id,
        "next_issue",
        {"issue": issue},
        "accepted",
        f"issue {issue} prioritized for the next claim",
    )
    state["priority"] = {
        "request_id": request_id,
        "sequence": record["sequence"],
        "issue": issue,
    }
    _save_state(state, path)
    armed = state.get("crash_armed")
    if isinstance(armed, dict) and armed.get("point") == "between-commit-and-reply":
        return _fire_between_commit_and_reply(state, path, request_id)
    sys.stdout.write(shared.render_success({"command": record, "replayed": False}))
    return 0


def _do_mutation(state: dict[str, Any], path: str | None, parsed: shared.ParsedCall) -> int:
    assert parsed.request_id is not None and parsed.expect_repo is not None
    repository = _repository()
    if not shared.repositories_match(parsed.expect_repo, repository):
        text, exit_code = shared.render_error(
            "repository_mismatch",
            f"expected {parsed.expect_repo}, this instance targets {repository}",
            details={"repository": repository},
            request_id=parsed.request_id,
        )
        sys.stdout.write(text)
        return exit_code
    kind, payload = _mutation_payload(parsed.operation, parsed.arguments)
    commands = state.get("commands")
    assert isinstance(commands, dict)
    stored = commands.get(parsed.request_id)
    if isinstance(stored, dict):
        if stored.get("kind") == kind and stored.get("arguments") == payload:
            record = stored.get("record")
            assert isinstance(record, dict)
            sys.stdout.write(shared.render_success({"command": record, "replayed": True}))
            return 0
        text, exit_code = shared.render_error(
            "payload_mismatch",
            f"request {parsed.request_id} was already used for a different command",
            request_id=parsed.request_id,
        )
        sys.stdout.write(text)
        return exit_code
    if parsed.operation == "stop":
        return _do_stop(state, path, parsed.request_id, parsed.arguments)
    if parsed.operation == "resume":
        return _do_resume(state, path, parsed.request_id)
    if parsed.operation == "next-issue":
        return _do_next_issue(state, path, parsed.request_id, parsed.arguments)
    text, exit_code = shared.render_error(
        "internal",
        f"stub producer implements stop, resume and next issue only (got {parsed.operation})",
        details={"stored": False},
        request_id=parsed.request_id,
    )
    sys.stdout.write(text)
    return exit_code


def _do_command(state: dict[str, Any], request_id: str) -> int:
    commands = state.get("commands")
    record = None
    if isinstance(commands, dict):
        stored = commands.get(request_id)
        if isinstance(stored, dict) and isinstance(stored.get("record"), dict):
            record = stored["record"]
    if record is None:
        text, exit_code = shared.render_error(
            "not_found", f"no command is recorded for {request_id}"
        )
        sys.stdout.write(text)
        return exit_code
    sys.stdout.write(shared.render_success({"command": record}))
    return 0


def _attempt_summary_for(
    attempt_id: str,
    issue_number: int,
    issue_title: str | None,
    started_at: str,
    finished_at: str | None,
    lifecycle_state: str,
    outcome_native: str | None,
    outcome_reason: str | None,
    sealed: bool,
    sealed_at: str | None,
) -> dict[str, Any]:
    if outcome_native is None:
        outcome: dict[str, Any] | None = None
    else:
        outcome = {
            "native": outcome_native,
            "reason": outcome_reason,
            "label": outcome_native.replace("_", " ").title(),
        }
    return {
        "attempt_id": attempt_id,
        "issue": {"number": issue_number, "title": issue_title},
        "started_at": started_at,
        "finished_at": finished_at,
        "lifecycle_state": lifecycle_state,
        "outcome": outcome,
        "delivery": None,
        "attention_required": False,
        "sealed": sealed,
        "sealed_at": sealed_at,
    }


def _active_summary(state: dict[str, Any]) -> dict[str, Any] | None:
    active = state.get("active_attempt")
    if not isinstance(active, dict):
        return None
    return _attempt_summary_for(
        str(active.get("attempt_id", "")),
        int(active.get("issue_number", 1)),
        active.get("issue_title") if isinstance(active.get("issue_title"), str) else None,
        str(active.get("started_at", _utc_now())),
        None,
        "open",
        active.get("outcome_native") if isinstance(active.get("outcome_native"), str) else None,
        active.get("outcome_reason") if isinstance(active.get("outcome_reason"), str) else None,
        False,
        None,
    )


def _do_attempts_list(state: dict[str, Any], arguments: dict[str, Any]) -> int:
    limit_raw = arguments.get("limit", "20")
    try:
        limit = int(str(limit_raw), 10)
    except ValueError:
        text, exit_code = shared.render_error(
            "invalid_argument", f"invalid --limit {limit_raw!r}: expected 1..100"
        )
        sys.stdout.write(text)
        return exit_code
    if limit < 1 or limit > 100:
        text, exit_code = shared.render_error(
            "invalid_argument", f"invalid --limit {limit_raw!r}: expected 1..100"
        )
        sys.stdout.write(text)
        return exit_code
    offset = 0
    if "before" in arguments:
        cursor = arguments["before"]
        decoded = _decode_cursor(str(cursor)) if isinstance(cursor, str) else None
        if decoded is None:
            text, exit_code = shared.render_error(
                "invalid_argument", f"invalid --before {cursor!r}: expected an opaque cursor"
            )
            sys.stdout.write(text)
            return exit_code
        offset = decoded
    summaries: list[dict[str, Any]] = []
    active_summary = _active_summary(state)
    if active_summary is not None:
        summaries.append(active_summary)
    attempts = state.get("attempts")
    order = state.get("attempt_order")
    if isinstance(attempts, dict) and isinstance(order, list):
        for attempt_id in reversed(order):
            summary = attempts.get(attempt_id)
            if isinstance(summary, dict):
                summaries.append(summary)
    page = summaries[offset : offset + limit]
    if offset + limit < len(summaries):
        next_cursor: str | None = _encode_cursor(offset + limit)
    else:
        next_cursor = None
    sys.stdout.write(shared.render_success({"attempts": page, "next_cursor": next_cursor}))
    return 0


def _read_archive_bytes(attempt_id: str, filename: str) -> bytes | None:
    """Read one archive file from the state volume, or None without a volume."""
    base = _archives_dir()
    if base is None:
        return None
    path = os.path.join(base, _safe_attempt_dir(attempt_id), filename)
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        return None


def _fresh_manifest(
    state: dict[str, Any], summary: dict[str, Any], offline: bool = False
) -> list[dict[str, Any]]:
    """Compute the current manifest for one attempt from the volume and state.

    Offline the volume is mounted read-only, so no archive file is created or
    rewritten: entries fall back to the state alone.
    """
    attempt_id = summary.get("attempt_id")
    if not isinstance(attempt_id, str) or not attempt_id:
        return []
    if not offline:
        _write_archives(state)
    events_payload = _read_archive_bytes(attempt_id, "events.jsonl")
    if events_payload is None:
        lines: list[str] = []
        events = state.get("recent_events")
        if isinstance(events, list):
            for event in events:
                if isinstance(event, dict) and event.get("attempt_id") == attempt_id:
                    lines.append(json.dumps(event, sort_keys=True))
        events_payload = ("".join(line + "\n" for line in lines)).encode("utf-8")
    transcript_payload = _read_archive_bytes(attempt_id, "transcript.jsonl")
    if transcript_payload is None:
        transcript_payload = (
            json.dumps({"attempt_id": attempt_id, "stream": "transcript"}, sort_keys=True).encode()
            + b"\n"
        )
    return [
        {
            "path": "events.jsonl",
            "kind": "events",
            "media_type": "application/x-ndjson",
            "size": len(events_payload),
            "sha256": hashlib.sha256(events_payload).hexdigest(),
        },
        {
            "path": "transcript.jsonl",
            "kind": "transcript",
            "media_type": "application/x-ndjson",
            "size": len(transcript_payload),
            "sha256": hashlib.sha256(transcript_payload).hexdigest(),
        },
    ]


def _manifest_for(
    state: dict[str, Any], summary: dict[str, Any], offline: bool = False
) -> list[dict[str, Any]]:
    """Return the manifest for one attempt, preferring a stored snapshot.

    An unsealed attempt paused after its outcome carries ``manifest_snapshot``
    (taken when the outcome was recorded); a sealed summary carries its stored
    ``manifest``. Either snapshot is served as-is so a file that grows while
    unsealed no longer matches it (the torn read of spec section 14), while a
    sealed archive stays immutable. Without a snapshot the manifest is fresh.
    """
    attempt_id = summary.get("attempt_id")
    active = state.get("active_attempt")
    if (
        isinstance(active, dict)
        and isinstance(attempt_id, str)
        and active.get("attempt_id") == attempt_id
    ):
        snapshot = active.get("manifest_snapshot")
        if isinstance(snapshot, list) and snapshot and all(isinstance(e, dict) for e in snapshot):
            return [dict(entry) for entry in snapshot]
        return _fresh_manifest(state, summary, offline)
    attempts = state.get("attempts")
    if isinstance(attempts, dict) and isinstance(attempt_id, str):
        stored = attempts.get(attempt_id)
        if isinstance(stored, dict):
            snapshot = stored.get("manifest")
            if isinstance(snapshot, list) and snapshot and all(
                isinstance(e, dict) for e in snapshot
            ):
                return [dict(entry) for entry in snapshot]
            return _fresh_manifest(state, summary, offline)
    return _fresh_manifest(state, summary, offline)


def _do_attempts_show(state: dict[str, Any], attempt_id: str, offline: bool = False) -> int:
    active = state.get("active_attempt")
    if isinstance(active, dict) and active.get("attempt_id") == attempt_id:
        summary = _active_summary(state)
        assert summary is not None
        sys.stdout.write(
            shared.render_success(
                {"attempt": summary, "manifest": _manifest_for(state, summary, offline)}
            )
        )
        return 0
    attempts = state.get("attempts")
    if isinstance(attempts, dict):
        summary = attempts.get(attempt_id)
        if isinstance(summary, dict):
            sys.stdout.write(
                shared.render_success(
                    {"attempt": summary, "manifest": _manifest_for(state, summary, offline)}
                )
            )
            return 0
    text, exit_code = shared.render_error("not_found", f"no attempt {attempt_id!r} is recorded")
    sys.stdout.write(text)
    return exit_code


def _unreachable(request_id: str | None) -> int:
    text, exit_code = shared.render_error(
        "agent_unreachable",
        "the stub engine is not running; start the container and retry",
        request_id=request_id,
    )
    sys.stdout.write(text)
    return exit_code


def _fresh_status_response() -> int:
    """Load, tick, save and serve a fresh bounded snapshot (lock must be held)."""
    state, path = _load_state()
    if state.get("engine_alive") is not True:
        return _unreachable(None)
    crashed = _tick(state)
    _save_state(state, path)
    if crashed == "crashed":
        return _unreachable(None)
    snapshot = _apply_bounds(_status(False, state))
    _write_prepared(snapshot)
    sys.stdout.write(shared.render_success(snapshot))
    return 0


def _run_online_status() -> int:
    """Serve ``status`` without ever waiting on the engine lock (spec 9.1).

    With the lock free the engine ticks and serves a fresh bounded snapshot.
    While a mutation or a harness ``hold-lock`` holds it, the engine serves
    the last prepared snapshot, whose ``observed_at`` predates the hold.
    """
    lock_path = _lock_path()
    if lock_path is not None:
        handle = _acquire_nonblocking(lock_path)
        if handle is not None:
            try:
                return _fresh_status_response()
            finally:
                _release_lock(handle)
        prepared = _read_prepared()
        if prepared is not None:
            sys.stdout.write(shared.render_success(prepared))
            return 0
        handle = _acquire_blocking(lock_path)
        try:
            return _fresh_status_response()
        finally:
            _release_lock(handle)
    return _fresh_status_response()


def _run_locked_mutation(parsed: shared.ParsedCall) -> int:
    """Commit one mutation while holding the engine lock (spec section 3.3)."""
    assert parsed.request_id is not None and parsed.expect_repo is not None
    handle = _acquire_blocking(_lock_path())
    try:
        state, path = _load_state()
        if state.get("engine_alive") is not True:
            return _unreachable(parsed.request_id)
        return _do_mutation(state, path, parsed)
    finally:
        _release_lock(handle)


def _do_attempts_export(
    state: dict[str, Any], arguments: dict[str, Any], offline: bool = False
) -> int:
    """Stream an ``attempts export`` tar (spec section 11.3).

    The stream starts at once with ``manifest.json``; an unknown attempt or
    path answers ``not_found`` before streaming starts. The manifest is the
    stored snapshot when one exists (unsealed after its outcome, or sealed),
    while the file bytes are current: a file that grew while unsealed no
    longer matches its snapshot, the torn read of spec section 14. A
    non-zero exit after streaming started means the consumer discards output.
    Offline the volume is mounted read-only, so no archive file is written.
    """
    attempt_id = arguments.get("attempt_id")
    assert isinstance(attempt_id, str)
    summary: dict[str, Any] | None = None
    active = state.get("active_attempt")
    if isinstance(active, dict) and active.get("attempt_id") == attempt_id:
        summary = _active_summary(state)
    else:
        attempts = state.get("attempts")
        if isinstance(attempts, dict):
            found = attempts.get(attempt_id)
            if isinstance(found, dict):
                summary = found
    if summary is None:
        text, exit_code = shared.render_error(
            "not_found", f"no attempt {attempt_id!r} is recorded"
        )
        sys.stdout.write(text)
        return exit_code
    files = _manifest_for(state, summary, offline)
    wanted = arguments.get("paths")
    assert isinstance(wanted, list)
    if wanted:
        known = {entry["path"] for entry in files}
        for path in wanted:
            if path not in known:
                text, exit_code = shared.render_error(
                    "not_found", f"no archive path {path!r} in attempt {attempt_id!r}"
                )
                sys.stdout.write(text)
                return exit_code
        files = [entry for entry in files if entry["path"] in wanted]
    manifest = {"contract": "1.0", "attempt": summary, "files": files}
    manifest_bytes = (json.dumps(manifest, sort_keys=True) + "\n").encode("utf-8")
    # Stream current bytes (which may have grown past a snapshot manifest).
    if not offline:
        _write_archives(state)
    payloads: dict[str, bytes] = {}
    for entry in files:
        name = str(entry["path"])
        data = _read_archive_bytes(attempt_id, name)
        if data is None:
            lines: list[str] = []
            events = state.get("recent_events")
            if isinstance(events, list) and name == "events.jsonl":
                for event in events:
                    if isinstance(event, dict) and event.get("attempt_id") == attempt_id:
                        lines.append(json.dumps(event, sort_keys=True))
                data = ("".join(line + "\n" for line in lines)).encode("utf-8")
            else:
                data = (
                    json.dumps({"attempt_id": attempt_id, "stream": "transcript"}).encode()
                    + b"\n"
                )
        payloads[name] = data
    stream = sys.stdout.buffer
    with tarfile.open(fileobj=stream, mode="w|") as archive:
        info = tarfile.TarInfo("manifest.json")
        info.size = len(manifest_bytes)
        archive.addfile(info, io.BytesIO(manifest_bytes))
        for entry in files:
            name = str(entry["path"])
            data = payloads[name]
            info = tarfile.TarInfo(name)
            info.size = len(data)
            archive.addfile(info, io.BytesIO(data))
    stream.flush()
    return 0


def main(argv: list[str]) -> int:
    parsed = shared.parse_argv(argv, capabilities=_advertised_capabilities())
    if isinstance(parsed, shared.ArgvFailure):
        text, exit_code = shared.render_error(
            parsed.code,
            parsed.message,
            details=parsed.details or None,
            request_id=parsed.request_id,
        )
        sys.stdout.write(text)
        return exit_code
    if parsed.offline and _live_holder_present():
        text, exit_code = shared.render_error(
            "rejected",
            "a live engine holds the volume; refusing the offline read",
            details={"reason": "instance_running"},
        )
        sys.stdout.write(text)
        return exit_code
    if parsed.operation == "identity":
        state, _ = _load_state()
        if not parsed.offline and state.get("engine_alive") is not True:
            return _unreachable(None)
        sys.stdout.write(shared.render_success(_identity(parsed.offline, state)))
        return 0
    if parsed.operation == "status" and not parsed.offline:
        return _run_online_status()
    state, path = _load_state()
    if not parsed.offline and state.get("engine_alive") is not True:
        return _unreachable(parsed.request_id)
    if parsed.operation == "status":
        sys.stdout.write(shared.render_success(_apply_bounds(_status(True, state))))
        return 0
    if parsed.operation == "command":
        request_id = parsed.arguments.get("request_id")
        assert isinstance(request_id, str)
        return _do_command(state, request_id)
    if parsed.operation == "attempts-list":
        return _do_attempts_list(state, parsed.arguments)
    if parsed.operation == "attempts-show":
        attempt_id = parsed.arguments.get("attempt_id")
        assert isinstance(attempt_id, str)
        return _do_attempts_show(state, attempt_id, parsed.offline)
    if parsed.operation == "attempts-export":
        return _do_attempts_export(state, parsed.arguments, parsed.offline)
    if parsed.operation in ("stop", "resume", "next-issue"):
        assert parsed.request_id is not None and parsed.expect_repo is not None
        return _run_locked_mutation(parsed)
    text, exit_code = shared.render_error(
        "internal",
        "stub producer implements identity, status, command, attempts list/show/export, "
        f"stop, resume and next issue only (got {parsed.operation})",
        details={"stored": False},
        request_id=parsed.request_id,
    )
    sys.stdout.write(text)
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
