{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent operator contract attempts show result",
  "description": "The result of attempts show (spec section 6.1): one AttemptSummary plus its manifest of ManifestEntry records.",
  "type": "object",
  "required": ["attempt", "manifest"],
  "properties": {
    "attempt": {"$ref": "#/$defs/attempt_summary"},
    "manifest": {"type": "array", "items": {"$ref": "#/$defs/manifest_entry"}}
  },
  "$defs": {
    "attempt_summary": {
      "type": "object",
      "required": [
        "attempt_id",
        "issue",
        "started_at",
        "finished_at",
        "lifecycle_state",
        "outcome",
        "delivery",
        "attention_required",
        "sealed",
        "sealed_at"
      ],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "issue": {
          "type": "object",
          "required": ["number", "title"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "title": {"type": ["string", "null"]}
          }
        },
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "finished_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "lifecycle_state": {"type": "string", "minLength": 1},
        "outcome": {
          "type": ["object", "null"],
          "required": ["native", "reason", "label"],
          "properties": {
            "native": {"type": "string", "minLength": 1},
            "reason": {"type": ["string", "null"]},
            "label": {"type": "string", "minLength": 1}
          }
        },
        "delivery": {
          "type": ["object", "null"],
          "required": ["pull_request"],
          "properties": {
            "pull_request": {
              "type": ["object", "null"],
              "required": ["number", "url"],
              "properties": {
                "number": {"type": "integer", "minimum": 1},
                "url": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "attention_required": {"type": "boolean"},
        "sealed": {"type": "boolean"},
        "sealed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"sealed": {"const": true}}, "required": ["sealed"]},
          "then": {"properties": {"sealed_at": {"type": "string"}}}
        },
        {
          "if": {"properties": {"sealed": {"const": false}}, "required": ["sealed"]},
          "then": {"properties": {"sealed_at": {"const": null}}}
        }
      ]
    },
    "manifest_entry": {
      "type": "object",
      "required": ["path", "kind", "media_type", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "events",
            "transcript",
            "tool_call",
            "tool_result",
            "model_output",
            "command_output",
            "record",
            "other"
          ]
        },
        "media_type": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
