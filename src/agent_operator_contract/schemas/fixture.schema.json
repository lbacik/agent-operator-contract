{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent operator contract consumer fixture",
  "description": "One recorded agentctl invocation: argv (without the agentctl binary itself), the exit code, and the exact stdout and stderr bytes (spec section 15).",
  "type": "object",
  "required": ["argv", "exit_code", "stdout", "stderr"],
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
