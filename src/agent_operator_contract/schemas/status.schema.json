{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent operator contract StatusSnapshot",
  "description": "The status result document (spec section 7.2): identity, instance, intake, current attempt with budget and figures, last finished attempt, recent commands and events. Figure value is null exactly when basis is unavailable or not_applicable; process_started_at is null exactly when mode is offline.",
  "type": "object",
  "required": [
    "generated_at",
    "identity",
    "instance",
    "intake",
    "current_attempt",
    "last_finished",
    "recent_commands",
    "recent_events",
    "truncated"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "When this document was produced (spec section 9.1)."
    },
    "identity": {
      "type": "object",
      "required": [
        "backend",
        "agent_version",
        "contract",
        "repository",
        "mode",
        "process_started_at",
        "capabilities"
      ],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "agent_version": {"type": "string", "minLength": 1},
        "contract": {
          "type": "object",
          "required": ["major", "minor"],
          "properties": {
            "major": {"type": "integer", "minimum": 1},
            "minor": {"type": "integer", "minimum": 0}
          }
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "mode": {"type": "string", "enum": ["online", "offline"]},
        "process_started_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "offline"}}, "required": ["mode"]},
          "then": {"properties": {"process_started_at": {"const": null}}},
          "else": {"properties": {"process_started_at": {"type": "string"}}}
        }
      ]
    },
    "instance": {
      "type": "object",
      "required": ["state", "startup_check", "last_halt", "observed_at"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["starting", "recovering", "idle", "active", "draining", "paused", "stopped"]
        },
        "startup_check": {
          "type": ["string", "null"]
        },
        "last_halt": {
          "type": ["object", "null"],
          "required": ["reason", "detail", "at"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "detail": {"type": "string"},
            "at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
            }
          }
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "starting"}}, "required": ["state"]},
          "then": {"properties": {"startup_check": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "intake": {
      "type": "object",
      "required": ["state", "pending_stop", "stop_plan", "priority", "observed_at"],
      "properties": {
        "state": {"type": "string", "enum": ["open", "closed"]},
        "pending_stop": {
          "type": ["object", "null"],
          "required": ["request_id", "sequence"],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "sequence": {"type": "integer", "minimum": 0}
          }
        },
        "stop_plan": {
          "type": ["object", "null"],
          "required": ["request_id", "remaining", "counted"],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "remaining": {"type": "integer", "minimum": 0},
            "counted": {"type": "integer", "minimum": 0}
          }
        },
        "priority": {
          "type": ["object", "null"],
          "required": ["request_id", "issue"],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "issue": {"type": "integer", "minimum": 1}
          }
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "current_attempt": {
      "type": ["object", "null"],
      "required": [
        "attempt_id",
        "issue",
        "native_phase",
        "started_at",
        "last_activity_at",
        "observed_at",
        "budget",
        "figures"
      ],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "issue": {
          "type": "object",
          "required": ["number", "title"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "title": {"type": ["string", "null"]}
          }
        },
        "native_phase": {"type": "string", "minLength": 1},
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "last_activity_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "budget": {"$ref": "#/$defs/budget"},
        "figures": {
          "type": "object",
          "properties": {
            "cost_usd": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "usd"}}},
            "cache_hit_rate": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "ratio"}}},
            "context_used": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "tokens"}}},
            "context_peak": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "tokens"}}},
            "context_window": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "tokens"}}},
            "turns": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "count"}}},
            "tool_calls": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "count"}}},
            "continuations": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "count"}}},
            "review_seats_running": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "count"}}},
            "elapsed_seconds": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "seconds"}}}
          },
          "additionalProperties": {"$ref": "#/$defs/figure"}
        }
      }
    },
    "last_finished": {
      "type": ["object", "null"],
      "required": [
        "attempt_id",
        "issue",
        "started_at",
        "finished_at",
        "lifecycle_state",
        "outcome",
        "delivery",
        "attention_required",
        "sealed",
        "sealed_at"
      ],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "issue": {
          "type": "object",
          "required": ["number", "title"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "title": {"type": ["string", "null"]}
          }
        },
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "finished_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "lifecycle_state": {"type": "string", "minLength": 1},
        "outcome": {
          "type": ["object", "null"],
          "required": ["native", "reason", "label"],
          "properties": {
            "native": {"type": "string", "minLength": 1},
            "reason": {"type": ["string", "null"]},
            "label": {"type": "string", "minLength": 1}
          }
        },
        "delivery": {
          "type": ["object", "null"],
          "required": ["pull_request"],
          "properties": {
            "pull_request": {
              "type": ["object", "null"],
              "required": ["number", "url"],
              "properties": {
                "number": {"type": "integer", "minimum": 1},
                "url": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "attention_required": {"type": "boolean"},
        "sealed": {"type": "boolean"},
        "sealed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"sealed": {"const": true}}, "required": ["sealed"]},
          "then": {"properties": {"sealed_at": {"type": "string"}}}
        },
        {
          "if": {"properties": {"sealed": {"const": false}}, "required": ["sealed"]},
          "then": {"properties": {"sealed_at": {"const": null}}}
        }
      ]
    },
    "recent_commands": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/command_record"}
    },
    "recent_events": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/contract_event"}
    },
    "truncated": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"instance": {"properties": {"state": {"const": "stopped"}}, "required": ["state"]}},
        "required": ["instance"]
      },
      "then": {"properties": {"identity": {"properties": {"mode": {"const": "offline"}}}}}
    },
    {
      "if": {
        "properties": {"identity": {"properties": {"mode": {"const": "offline"}}, "required": ["mode"]}},
        "required": ["identity"]
      },
      "then": {"properties": {"instance": {"properties": {"state": {"const": "stopped"}}}}}
    }
  ],
  "$defs": {
    "figure": {
      "type": "object",
      "required": ["value", "unit", "basis"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {
          "type": "string",
          "enum": ["tokens", "usd", "seconds", "count", "ratio"]
        },
        "basis": {
          "type": "string",
          "enum": ["measured", "estimated", "configured", "assumed", "unavailable", "not_applicable"]
        },
        "reason": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"basis": {"enum": ["unavailable", "not_applicable"]}},
            "required": ["basis"]
          },
          "then": {"properties": {"value": {"const": null}}},
          "else": {"properties": {"value": {"type": "number"}}}
        },
        {
          "if": {
            "properties": {"unit": {"const": "ratio"}, "value": {"type": "number"}},
            "required": ["unit", "value"]
          },
          "then": {"properties": {"value": {"minimum": 0, "maximum": 1}}}
        }
      ]
    },
    "budget": {
      "type": "object",
      "required": ["raw_tokens", "effective_tokens", "enforced_tokens", "limits"],
      "properties": {
        "raw_tokens": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "tokens"}}},
        "effective_tokens": {"$ref": "#/$defs/figure", "properties": {"unit": {"const": "tokens"}}},
        "enforced_tokens": {
          "type": "string",
          "enum": ["raw", "effective", "none"]
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "used", "limit"],
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "raw_tokens",
                      "effective_tokens",
                      "cost_usd",
                      "wall_clock_seconds",
                      "tool_calls",
                      "turns"
                    ]
                  },
                  {"type": "string", "pattern": "^native\\..+"}
                ]
              },
              "used": {"$ref": "#/$defs/figure"},
              "limit": {"$ref": "#/$defs/figure"}
            },
            "allOf": [
              {
                "if": {"properties": {"name": {"const": "raw_tokens"}}, "required": ["name"]},
                "then": {
                  "properties": {
                    "used": {"properties": {"unit": {"const": "tokens"}}},
                    "limit": {"properties": {"unit": {"const": "tokens"}}}
                  }
                }
              },
              {
                "if": {"properties": {"name": {"const": "effective_tokens"}}, "required": ["name"]},
                "then": {
                  "properties": {
                    "used": {"properties": {"unit": {"const": "tokens"}}},
                    "limit": {"properties": {"unit": {"const": "tokens"}}}
                  }
                }
              },
              {
                "if": {"properties": {"name": {"const": "cost_usd"}}, "required": ["name"]},
                "then": {
                  "properties": {
                    "used": {"properties": {"unit": {"const": "usd"}}},
                    "limit": {"properties": {"unit": {"const": "usd"}}}
                  }
                }
              },
              {
                "if": {"properties": {"name": {"const": "wall_clock_seconds"}}, "required": ["name"]},
                "then": {
                  "properties": {
                    "used": {"properties": {"unit": {"const": "seconds"}}},
                    "limit": {"properties": {"unit": {"const": "seconds"}}}
                  }
                }
              },
              {
                "if": {"properties": {"name": {"const": "tool_calls"}}, "required": ["name"]},
                "then": {
                  "properties": {
                    "used": {"properties": {"unit": {"const": "count"}}},
                    "limit": {"properties": {"unit": {"const": "count"}}}
                  }
                }
              },
              {
                "if": {"properties": {"name": {"const": "turns"}}, "required": ["name"]},
                "then": {
                  "properties": {
                    "used": {"properties": {"unit": {"const": "count"}}},
                    "limit": {"properties": {"unit": {"const": "count"}}}
                  }
                }
              }
            ]
          }
        }
      }
    },
    "command_record": {
      "type": "object",
      "required": [
        "request_id",
        "sequence",
        "kind",
        "arguments",
        "repository",
        "acknowledgement",
        "detail",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {
          "type": "string",
          "enum": [
            "stop",
            "stop_after",
            "resume",
            "next_issue",
            "handoff",
            "recovery_retry",
            "recovery_release",
            "errors_reset"
          ]
        },
        "arguments": {
          "type": "object",
          "description": "Kind-specific arguments (spec section 7.5); the idempotency payload."
        },
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "acknowledgement": {
          "type": "string",
          "enum": ["accepted", "completed", "superseded", "not_fulfilled"]
        },
        "detail": {"type": "string", "pattern": "^[^\\r\\n]*$"},
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "stop_after"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "arguments": {
                "required": ["after"],
                "properties": {
                  "after": {"type": "integer", "minimum": 1, "maximum": 999}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "next_issue"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "arguments": {
                "required": ["issue"],
                "properties": {
                  "issue": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "recovery_retry"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "arguments": {
                "required": ["attempt_id"],
                "properties": {
                  "attempt_id": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "recovery_release"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "arguments": {
                "required": ["attempt_id", "saved_at"],
                "properties": {
                  "attempt_id": {"type": "string", "minLength": 1},
                  "saved_at": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      ]
    },
    "contract_event": {
      "type": "object",
      "required": ["at", "level", "event", "text"],
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "level": {"type": "string", "enum": ["debug", "info", "warning", "error"]},
        "event": {"type": "string", "minLength": 1},
        "text": {"type": "string", "maxLength": 300},
        "attempt_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "issue": {"type": "integer", "minimum": 1},
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "stop",
            "stop_after",
            "resume",
            "next_issue",
            "handoff",
            "recovery_retry",
            "recovery_release",
            "errors_reset"
          ]
        },
        "acknowledgement": {
          "type": "string",
          "enum": ["accepted", "completed", "superseded", "not_fulfilled"]
        },
        "outcome": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "check": {"type": "string", "minLength": 1},
        "result": {"type": "string", "enum": ["started", "ok", "skipped", "failed"]},
        "agent_version": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"event": {"const": "process_started"}}, "required": ["event"]},
          "then": {"required": ["agent_version"]}
        },
        {
          "if": {"properties": {"event": {"const": "startup_check"}}, "required": ["event"]},
          "then": {"required": ["check", "result"]}
        },
        {
          "if": {"properties": {"event": {"const": "halted"}}, "required": ["event"]},
          "then": {"required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"event": {"const": "claim_opened"}}, "required": ["event"]},
          "then": {"required": ["attempt_id", "issue"]}
        },
        {
          "if": {"properties": {"event": {"const": "phase_changed"}}, "required": ["event"]},
          "then": {"required": ["attempt_id", "phase"]}
        },
        {
          "if": {"properties": {"event": {"const": "outcome_recorded"}}, "required": ["event"]},
          "then": {"required": ["attempt_id", "outcome", "reason"]}
        },
        {
          "if": {"properties": {"event": {"const": "attempt_finished"}}, "required": ["event"]},
          "then": {"required": ["attempt_id"]}
        },
        {
          "if": {"properties": {"event": {"const": "attempt_released"}}, "required": ["event"]},
          "then": {"required": ["attempt_id"]}
        },
        {
          "if": {"properties": {"event": {"const": "sealed"}}, "required": ["event"]},
          "then": {"required": ["attempt_id"]}
        },
        {
          "if": {"properties": {"event": {"const": "command_accepted"}}, "required": ["event"]},
          "then": {"required": ["request_id", "kind", "acknowledgement"]}
        },
        {
          "if": {"properties": {"event": {"const": "command_resolved"}}, "required": ["event"]},
          "then": {"required": ["request_id", "acknowledgement"]}
        }
      ]
    }
  }
}
