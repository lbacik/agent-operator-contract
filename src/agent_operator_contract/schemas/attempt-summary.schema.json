{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent operator contract AttemptSummary",
  "description": "One attempt in an archive listing or show result (spec section 7.4): native lifecycle state, outcome, delivery and sealing. sealed_at is set exactly when sealed is true.",
  "type": "object",
  "required": [
    "attempt_id",
    "issue",
    "started_at",
    "finished_at",
    "lifecycle_state",
    "outcome",
    "delivery",
    "attention_required",
    "sealed",
    "sealed_at"
  ],
  "properties": {
    "attempt_id": {"type": "string", "minLength": 1},
    "issue": {
      "type": "object",
      "required": ["number", "title"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": ["string", "null"]}
      }
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "finished_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "lifecycle_state": {"type": "string", "minLength": 1},
    "outcome": {
      "type": ["object", "null"],
      "required": ["native", "reason", "label"],
      "properties": {
        "native": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "delivery": {
      "type": ["object", "null"],
      "required": ["pull_request"],
      "properties": {
        "pull_request": {
          "type": ["object", "null"],
          "required": ["number", "url"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "url": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "attention_required": {"type": "boolean"},
    "sealed": {"type": "boolean"},
    "sealed_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sealed": {"const": true}}, "required": ["sealed"]},
      "then": {"properties": {"sealed_at": {"type": "string"}}}
    },
    {
      "if": {"properties": {"sealed": {"const": false}}, "required": ["sealed"]},
      "then": {"properties": {"sealed_at": {"const": null}}}
    }
  ]
}
