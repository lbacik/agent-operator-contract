#!/usr/bin/env python3
"""Fake `docker` executable for the consumer suite (spec section 15).

It stands in for the `docker` CLI: it serves a described Fleet for listing
and inspection, answers `exec` of `agentctl` by replaying fixtures matched on
argv, and records every invocation so a test can assert what the consumer
sent. Standard library only; usable from a checkout of the tag without Python
imports (see README.md in this directory).

Fleet description (JSON file, `FAKE_DOCKER_FLEET`):

    {"containers": [{"id": "...", "name": "...", "backend": "...",
                     "contract": "1", "exec_user": "...",
                     "state": "running", "oneoff": false,
                     "image": "sha256:abc",
                     "volumes": [{"name": "stub-data", "path": "/data"}],
                     "binds": [{"source": "/host/cfg", "path": "/cfg"}]}]}

`oneoff: true` sets the Compose one-off label
`com.docker.compose.oneoff=True`, which the consumer must ignore. `image` is
the image ID reported by `inspect`; `volumes` and `binds` are the durable
mounts reported as `Mounts` entries so Offline Read (`docker run` of the
stopped container's image with every mount re-mounted read-only) can be
staged. A stopped container is read through `run`, never `exec`.

Fixtures (`FAKE_DOCKER_FIXTURES`, default: the checkout's
`src/agent_operator_contract/fixtures/agentctl/`): files shaped
`{argv, exit_code, stdout, stderr}`; `argv` excludes the agentctl binary
itself. An `exec` of `/usr/local/bin/agentctl --contract 1 <op>` replays the
first fixture whose `argv` matches the args after the binary. A fixture may
carry `stdout_base64` instead of `stdout` for byte streams that are not
UTF-8 text (an `attempts export` tar): the base64 payload is decoded and
written to stdout as bytes, so a binary export replays byte for byte.

Matching ignores the `--request-id` value by position (consumers generate
request IDs, so a test cannot know them in advance): two argvs match when
they are equal after masking the value following each `--request-id`. The
replayed stdout and stderr have the fixture's request ID replaced with the
one the consumer actually sent. When several fixtures match the same masked
argv, successive `exec` calls serve them in filename order (first call the
first file, second call the second, further calls repeat the last), so a
test stages an ambiguous reply followed by a replayed success as two files
with the same masked argv. A fixture may also carry `delay_seconds` (a
number): the fake sleeps that long before replying, so a delay longer than
the consumer timeout is staged the same way; `FAKE_DOCKER_DELAY` adds the
same sleep to every `exec`/`run` reply.

Recording (`FAKE_DOCKER_LOG`): every docker invocation appends one JSON line
`{"argv": [...]}` (args after the `docker` name itself).

Supported commands: `ps` (one container ID per line), `inspect <id>...`
(docker-inspect-shaped JSON array), `exec --user <user> <id>
/usr/local/bin/agentctl <agentctl-argv...>`, and Offline Read `run --rm
--network none --user <user> --mount <spec,readonly> ...
--entrypoint /usr/local/bin/agentctl <image> --contract 1 --offline ...`
(matched to its container by image; every mount must carry `readonly`).
Anything else exits 125.
"""

from __future__ import annotations

import base64
import json
import os
import sys
import time
from pathlib import Path

CONTRACT_LABEL = "io.github.lbacik.agent-operator.contract"
INSTANCE_LABEL = "io.github.lbacik.agent-operator.instance"
EXEC_USER_LABEL = "io.github.lbacik.agent-operator.exec-user"
BACKEND_LABEL = "io.github.lbacik.agent-operator.backend"
ONEOFF_LABEL = "com.docker.compose.oneoff"

AGENTCTL_PATH = "/usr/local/bin/agentctl"


def _repo_root() -> Path:
    return Path(__file__).resolve().parent.parent.parent


def _fleet_path() -> Path | None:
    env = os.environ.get("FAKE_DOCKER_FLEET")
    if env:
        return Path(env)
    return None


def _fixtures_dir() -> Path:
    env = os.environ.get("FAKE_DOCKER_FIXTURES")
    if env:
        return Path(env)
    return _repo_root() / "src" / "agent_operator_contract" / "fixtures" / "agentctl"


def _log_path() -> Path | None:
    env = os.environ.get("FAKE_DOCKER_LOG")
    if env:
        return Path(env)
    return None


def _record(argv: list[str]) -> None:
    log = _log_path()
    if log is None:
        return
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": argv}) + "\n")


def _load_fleet() -> dict[str, dict[str, object]]:
    path = _fleet_path()
    if path is None:
        sys.stderr.write("fake_docker: FAKE_DOCKER_FLEET is not set\n")
        raise SystemExit(125)
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        sys.stderr.write(f"fake_docker: cannot read fleet file: {exc}\n")
        raise SystemExit(125) from exc
    except ValueError as exc:
        sys.stderr.write(f"fake_docker: fleet file is not JSON: {exc}\n")
        raise SystemExit(125) from exc
    containers = doc.get("containers", [])
    by_id: dict[str, dict[str, object]] = {}
    for entry in containers:
        if isinstance(entry, dict) and isinstance(entry.get("id"), str):
            by_id[str(entry["id"])] = entry
    return by_id


def _inspect_entry(container_id: str, desc: dict[str, object]) -> dict[str, object]:
    labels = {
        CONTRACT_LABEL: str(desc.get("contract", "1")),
        INSTANCE_LABEL: str(desc.get("name", "")),
        BACKEND_LABEL: str(desc.get("backend", "")),
        EXEC_USER_LABEL: str(desc.get("exec_user", "")),
    }
    if desc.get("oneoff") is True:
        labels[ONEOFF_LABEL] = "True"
    state = str(desc.get("state", "running"))
    mounts: list[dict[str, object]] = []
    volumes = desc.get("volumes")
    if isinstance(volumes, list):
        for volume in volumes:
            if not isinstance(volume, dict):
                continue
            name = volume.get("name")
            path = volume.get("path")
            if isinstance(name, str) and name and isinstance(path, str) and path:
                mounts.append(
                    {
                        "Type": "volume",
                        "Name": name,
                        "Source": name,
                        "Destination": path,
                    }
                )
    binds = desc.get("binds")
    if isinstance(binds, list):
        for bind in binds:
            if not isinstance(bind, dict):
                continue
            source = bind.get("source")
            path = bind.get("path")
            if isinstance(source, str) and source and isinstance(path, str) and path:
                mounts.append({"Type": "bind", "Source": source, "Destination": path})
    return {
        "Id": container_id,
        "Image": str(desc.get("image", "example-image")),
        "Config": {"Labels": labels},
        "Mounts": mounts,
        "State": {"Status": state, "Running": state == "running"},
    }


def _cmd_ps(fleet: dict[str, dict[str, object]]) -> int:
    for container_id in fleet:
        sys.stdout.write(container_id + "\n")
    return 0


def _cmd_inspect(fleet: dict[str, dict[str, object]], ids: list[str]) -> int:
    if not ids:
        sys.stderr.write("fake_docker: inspect requires a container id\n")
        return 1
    entries = []
    for container_id in ids:
        desc = fleet.get(container_id)
        if desc is None:
            sys.stderr.write(f"fake_docker: no such container: {container_id}\n")
            return 1
        entries.append(_inspect_entry(container_id, desc))
    sys.stdout.write(json.dumps(entries) + "\n")
    return 0


def _load_fixtures() -> list[dict[str, object]]:
    directory = _fixtures_dir()
    fixtures: list[dict[str, object]] = []
    if not directory.is_dir():
        return fixtures
    for path in sorted(directory.glob("*.json")):
        if path.name == "index.json":
            continue
        try:
            doc = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(doc, dict):
            fixtures.append(doc)
    return fixtures


def _mask_request_id(argv: list[str]) -> tuple[str, ...]:
    """Mask the value after each ``--request-id`` so generated IDs still match."""
    masked = list(argv)
    for index, arg in enumerate(argv):
        if arg == "--request-id" and index + 1 < len(argv):
            masked[index + 1] = ""
    return tuple(masked)


def _request_id_of(argv: list[str]) -> str | None:
    """Return the ``--request-id`` value of an argv, if it carries one."""
    for index, arg in enumerate(argv):
        if arg == "--request-id" and index + 1 < len(argv):
            return argv[index + 1]
    return None


def _agentctl_argv_of(docker_argv: list[str]) -> list[str] | None:
    """Return the agentctl args of a recorded ``exec`` or ``run`` docker argv."""
    if not docker_argv:
        return None
    if docker_argv[0] == "exec":
        try:
            binary = docker_argv.index(AGENTCTL_PATH)
        except ValueError:
            return None
        return docker_argv[binary + 1 :]
    if docker_argv[0] == "run":
        try:
            entrypoint = docker_argv.index("--entrypoint")
        except ValueError:
            return None
        if len(docker_argv) <= entrypoint + 2:
            return None
        if docker_argv[entrypoint + 1] != AGENTCTL_PATH:
            return None
        return docker_argv[entrypoint + 3 :]
    return None


def _prior_matches(key: tuple[str, ...]) -> int:
    """Count earlier ``exec`` calls with the same masked agentctl argv.

    The current invocation is already recorded when ``exec`` runs, so it is
    subtracted: the result is the zero-based index of this call in its
    sequence.
    """
    log = _log_path()
    if log is None:
        return 0
    try:
        lines = log.read_text(encoding="utf-8").splitlines()
    except OSError:
        return 0
    count = 0
    for line in lines:
        if not line.strip():
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if not isinstance(entry, dict):
            continue
        argv = entry.get("argv")
        if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
            continue
        agentctl_argv = _agentctl_argv_of(argv)
        if agentctl_argv is not None and _mask_request_id(agentctl_argv) == key:
            count += 1
    return max(0, count - 1)


def _sleep_before_reply(fixture: dict[str, object]) -> None:
    """Sleep the fixture's ``delay_seconds`` plus ``FAKE_DOCKER_DELAY``."""
    wanted: list[float] = []
    raw = fixture.get("delay_seconds")
    if isinstance(raw, (int, float)) and not isinstance(raw, bool) and raw > 0:
        wanted.append(float(raw))
    env_raw = os.environ.get("FAKE_DOCKER_DELAY")
    if env_raw is not None and env_raw.strip():
        try:
            env_delay = float(env_raw.strip())
        except ValueError:
            env_delay = 0.0
        if env_delay > 0:
            wanted.append(env_delay)
    for delay in wanted:
        time.sleep(delay)


def _replay_fixture(agentctl_argv: list[str]) -> int:
    """Replay the first fixture whose argv matches ``agentctl_argv``."""
    key = _mask_request_id(agentctl_argv)
    matches: list[dict[str, object]] = []
    for fixture in _load_fixtures():
        raw_argv = fixture.get("argv")
        if not isinstance(raw_argv, list):
            continue
        fixture_argv = [str(a) for a in raw_argv]
        if _mask_request_id(fixture_argv) == key:
            matches.append(fixture)
    if matches:
        fixture = matches[min(_prior_matches(key), len(matches) - 1)]
        _sleep_before_reply(fixture)
        raw_argv = fixture.get("argv")
        assert isinstance(raw_argv, list)
        fixture_id = _request_id_of([str(a) for a in raw_argv])
        actual_id = _request_id_of(agentctl_argv)
        encoded = fixture.get("stdout_base64")
        if isinstance(encoded, str) and encoded:
            try:
                payload = base64.b64decode(encoded.encode("ascii"))
            except ValueError:
                sys.stderr.write("fake_docker: fixture stdout_base64 is not base64\n")
                return 1
            sys.stdout.buffer.write(payload)
            sys.stdout.buffer.flush()
        else:
            stdout = str(fixture.get("stdout", ""))
            if fixture_id is not None and actual_id is not None and fixture_id != actual_id:
                stdout = stdout.replace(fixture_id, actual_id)
            sys.stdout.write(stdout)
        stderr = str(fixture.get("stderr", ""))
        if fixture_id is not None and actual_id is not None and fixture_id != actual_id:
            stderr = stderr.replace(fixture_id, actual_id)
        sys.stderr.write(stderr)
        exit_code = fixture.get("exit_code", 0)
        return int(exit_code) if isinstance(exit_code, int) else 1
    sys.stderr.write(f"fake_docker: no fixture matches {agentctl_argv!r}\n")
    envelope = {
        "contract": "1.0",
        "ok": False,
        "error": {
            "code": "usage",
            "message": f"no recorded fixture for {agentctl_argv!r}",
            "retryable": False,
        },
    }
    sys.stdout.write(json.dumps(envelope) + "\n")
    return 2


def _cmd_exec(
    fleet: dict[str, dict[str, object]], args: list[str]
) -> int:
    try:
        user_index = args.index("--user")
        exec_user = args[user_index + 1]
        container_id = args[user_index + 2]
        rest = args[user_index + 3 :]
    except (ValueError, IndexError):
        sys.stderr.write("fake_docker: exec expects --user <user> <container> ...\n")
        return 125
    if not rest or rest[0] != AGENTCTL_PATH:
        sys.stderr.write(
            f"fake_docker: exec expects {AGENTCTL_PATH} after the container\n"
        )
        return 125
    agentctl_argv = rest[1:]
    desc = fleet.get(container_id)
    if desc is None:
        sys.stderr.write(f"fake_docker: no such container: {container_id}\n")
        return 125
    if exec_user != str(desc.get("exec_user", "")):
        sys.stderr.write(
            f"fake_docker: wrong exec user {exec_user!r} for {container_id}\n"
        )
        return 125
    return _replay_fixture(agentctl_argv)


def _cmd_run(
    fleet: dict[str, dict[str, object]], args: list[str]
) -> int:
    """Serve one Offline Read ``run``: match the image, check it is read-only."""
    if "--rm" not in args:
        sys.stderr.write("fake_docker: run expects --rm\n")
        return 125
    try:
        network_index = args.index("--network")
        network = args[network_index + 1]
    except (ValueError, IndexError):
        sys.stderr.write("fake_docker: run expects --network <name>\n")
        return 125
    if network != "none":
        sys.stderr.write(f"fake_docker: run expects --network none, got {network!r}\n")
        return 125
    try:
        user_index = args.index("--user")
        exec_user = args[user_index + 1]
    except (ValueError, IndexError):
        sys.stderr.write("fake_docker: run expects --user <user>\n")
        return 125
    try:
        entrypoint_index = args.index("--entrypoint")
        entrypoint = args[entrypoint_index + 1]
        image = args[entrypoint_index + 2]
        agentctl_argv = args[entrypoint_index + 3 :]
    except IndexError:
        sys.stderr.write("fake_docker: run expects --entrypoint <path> <image> ...\n")
        return 125
    except ValueError:
        sys.stderr.write("fake_docker: run expects --entrypoint <path> <image> ...\n")
        return 125
    if entrypoint != AGENTCTL_PATH:
        sys.stderr.write(f"fake_docker: run expects entrypoint {AGENTCTL_PATH!r}\n")
        return 125
    if "-t" in args or "--tty" in args or "-i" in args:
        sys.stderr.write("fake_docker: run must not allocate a TTY\n")
        return 125
    mounts: list[str] = []
    for index, arg in enumerate(args):
        if arg == "--mount" and index + 1 < len(args):
            mounts.append(args[index + 1])
    for mount in mounts:
        options = mount.split(",")
        if "readonly" not in options:
            sys.stderr.write(f"fake_docker: run mount is not read-only: {mount!r}\n")
            return 125
    if not agentctl_argv or agentctl_argv[:2] != ["--contract", "1"]:
        sys.stderr.write("fake_docker: run expects --contract 1 after the image\n")
        return 125
    desc: dict[str, object] | None = None
    for entry in fleet.values():
        if str(entry.get("image", "example-image")) == image:
            desc = entry
            break
    if desc is None:
        sys.stderr.write(f"fake_docker: no container with image {image!r}\n")
        return 125
    if exec_user != str(desc.get("exec_user", "")):
        sys.stderr.write(f"fake_docker: wrong exec user {exec_user!r} for {image!r}\n")
        return 125
    return _replay_fixture(agentctl_argv)


def main(argv: list[str]) -> int:
    _record(list(argv))
    if not argv:
        sys.stderr.write("fake_docker: no docker subcommand\n")
        return 125
    command, rest = argv[0], argv[1:]
    fleet = _load_fleet()
    if command == "ps":
        return _cmd_ps(fleet)
    if command == "inspect":
        ids = [arg for arg in rest if not arg.startswith("-")]
        return _cmd_inspect(fleet, ids)
    if command == "exec":
        return _cmd_exec(fleet, rest)
    if command == "run":
        return _cmd_run(fleet, rest)
    sys.stderr.write(f"fake_docker: unsupported docker command {command!r}\n")
    return 125


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
